@page "/"
@using Blazored.Toast.Services
@using CarWashApp.Services
@using CarWashApp.Models.DTOs

<PageTitle>Home Page</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-body text-center">
                    <h1 class="mb-4">Welcome to Car Wash Point!</h1>
                    <p class="mb-4">Please choose an option below:</p>
                    <div class="d-grid gap-3">
                        <div class="position-relative">
                            <div class="d-flex">
                                <input value="@searchText"
                                       @oninput="OnSearchInput"
                                       class="form-control me-2 uppercase-input"
                                       type="search"
                                       placeholder="Search..."
                                       aria-label="Search"
                                       @onkeypress="@OnKeyPress" />

                                <button @onclick="SearchCar" class="btn btn-outline-primary">Search</button>
                            </div>

                            @if (showSuggestions)
                            {
                                <div class="list-group position-absolute w-100 shadow-sm" style="z-index: 1050;">
                                    @foreach (var car in filteredCars)
                                    {
                                        <button type="button"
                                                class="list-group-item list-group-item-action text-start"
                                                @onclick="@(() => SelectCar(car.LicensePlate))">
                                            <strong>@car.LicensePlate</strong> - @car.Name (@car.Color)
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        <NavLink class="btn btn-primary btn-lg" href="car-registration">Car Registration</NavLink>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] NavigationManager NavigationManager { get; set; }
    [Inject] ICarService CarService { get; set; }
    [Inject] IToastService ToastService { get; set; }
    string searchText = string.Empty;
    List<CarDto> filteredCars = new();
    bool showSuggestions => searchText?.Trim().Length >= 2 && filteredCars.Count > 0;

    void SearchCar()
    {
        if (!string.IsNullOrEmpty(searchText))
        {
            var car = CarService.GetCarByLicensePlate(searchText.Trim());
            if (car != null)
            {
                NavigationManager.NavigateTo($"car-detail/{car.LicensePlate}");
            }
            else
            {
                ToastService.ShowError($"Car not found for {searchText}");
            }
        }
    }

    void OnSearchInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString()?.ToUpperInvariant() ?? string.Empty;
        var query = searchText.Trim();

        if (query.Length < 2)
        {
            filteredCars.Clear();
            return;
        }

        var squashed = new string(query.Where(ch => !char.IsWhiteSpace(ch)).ToArray());

        filteredCars = CarService.GetAllCars()
            .Where(car =>
                (!string.IsNullOrEmpty(car.LicensePlate) && new string(car.LicensePlate.Where(ch => !char.IsWhiteSpace(ch)).ToArray()).Contains(squashed, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(car.Name) && car.Name.Contains(query, StringComparison.OrdinalIgnoreCase)))
            .Take(8)
            .ToList();
    }

    void SelectCar(string licensePlate)
    {
        if (string.IsNullOrWhiteSpace(licensePlate)) return;
        searchText = licensePlate;
        filteredCars.Clear();
        NavigationManager.NavigateTo($"car-detail/{licensePlate}");
    }

    void OnKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SearchCar();
        }
    }
}
