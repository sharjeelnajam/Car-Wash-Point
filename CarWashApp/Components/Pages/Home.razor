@page "/"
@using CarWashApp.Services

<PageTitle>Home Page</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-body text-center">
                    <h1 class="mb-4">Welcome to Car Wash Point!</h1>
                    <p class="mb-4">Please choose an option below:</p>
                    <div class="d-grid gap-3">
                        <div class="d-flex">
                            @* <input value="@searchText" @oninput="@(e => searchText = e.Value?.ToString()?.ToUpperInvariant())"
                                   class="form-control me-2" type="search" placeholder="Search..." aria-label="Search"> *@
                            <InputText @bind-Value="searchText"
                                       class="form-control me-2 uppercase-input"
                                       type="search"
                                       placeholder="Search..."
                                       aria-label="Search"
                                       oninput="this.value = this.value.toUpperCase()"
                                       @onkeypress="@OnKeyPress" />


                                   <button @onclick="SearchCar" class="btn btn-outline-primary">Search</button>
                        </div>
                        <NavLink class="btn btn-primary btn-lg" href="car-registration">Car Registration</NavLink>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] NavigationManager NavigationManager { get; set; }
    [Inject] ICarService CarService { get; set; }
    string searchText = string.Empty;

    void SearchCar()
    {
        if (!string.IsNullOrEmpty(searchText))
        {
            var car = CarService.GetAllCars().Find(car => car.LicensePlate == searchText.Trim());
            if (car != null)
            {
                NavigationManager.NavigateTo($"car-detail/{car.LicensePlate}");
            }
            else
            {
                // Handle case where car is not found
                Console.WriteLine("Car not found");
            }
        }
    }

    void OnKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SearchCar();
        }
    }
}
