@page "/admin-panel"
@using CarWashApp.Responses.Logs.TransactionList
@using CarWashApp.Services
@using Blazored.Toast.Services
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject IToastService ToastService

@if (!AuthService.IsAuthenticated)
{
    <div class="container-fluid d-flex justify-content-center align-items-center min-vh-100">
        <div class="card shadow-lg text-center" style="max-width: 500px;">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Access Denied
                </h4>
            </div>
            <div class="card-body p-4">
                <p class="lead mb-4">You need to be logged in as an administrator to access this page.</p>
                <div class="d-grid gap-2">
                    <button class="btn btn-primary btn-lg" @onclick="GoToLogin">
                        <i class="bi bi-shield-lock me-2"></i>
                        Go to Admin Login
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="GoToHome">
                        <i class="bi bi-house me-2"></i>
                        Go to Home
                    </button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-primary mb-0">
            <i class="bi bi-gear-fill me-2"></i>Admin Panel
        </h3>
        <div class="d-flex align-items-center gap-3">
            <span class="text-muted">
                <i class="bi bi-person-circle me-1"></i>
                Welcome, @AuthService.Username
            </span>
            <button class="btn btn-outline-danger btn-sm" @onclick="Logout">
                <i class="bi bi-box-arrow-right me-1"></i>
                Logout
            </button>
        </div>
    </div>

    <CarsComponent />
}
