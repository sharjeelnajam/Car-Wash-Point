@page "/admin/invoices"
@using CarWashApp.Services
@using CarWashApp.Components.Shared
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject CarWashApp.Services.IAuthenticationService AuthService

@if (!AuthService.IsAuthenticated)
{
	<div class="container-fluid d-flex justify-content-center align-items-center min-vh-100">
		<div class="card shadow-lg text-center" style="max-width: 500px;">
			<div class="card-header bg-warning text-dark">
				<h4 class="mb-0">
					<i class="bi bi-exclamation-triangle me-2"></i>
					Access Denied
				</h4>
			</div>
			<div class="card-body p-4">
				<p class="lead mb-4">You need to be logged in as an administrator to access this page.</p>
				<div class="d-grid gap-2">
					<button class="btn btn-primary btn-lg" @onclick="@(() => Navigation.NavigateTo("/admin-login"))">
						<i class="bi bi-shield-lock me-2"></i>
						Go to Admin Login
					</button>
					<button class="btn btn-outline-secondary" @onclick="@(() => Navigation.NavigateTo("/"))">
						<i class="bi bi-house me-2"></i>
						Go to Home
					</button>
				</div>
			</div>
		</div>
	</div>
}
else
{
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h3 class="text-primary mb-0">
			<i class="bi bi-file-earmark-text me-2"></i>Invoices
		</h3>
		<div>
			<button class="btn btn-outline-secondary btn-sm" @onclick="@(() => Navigation.NavigateTo("/admin-panel"))">
				<i class="bi bi-arrow-left me-1"></i>Back to Admin Panel
			</button>
		</div>
	</div>

	@if (isLoading)
	{
		<div class="d-flex justify-content-center align-items-center p-5">
			<div class="spinner-border text-primary" role="status">
				<span class="visually-hidden">Loading...</span>
			</div>
		</div>
	}
	else if (!invoiceFiles.Any())
	{
		<div class="alert alert-info">
			<i class="bi bi-info-circle me-2"></i>No invoices found in the configured folder.
		</div>
	}
	else
	{
		<div class="row g-3">
			@foreach (var file in pagedFiles)
			{
				<div class="col-12 col-sm-6 col-md-4 col-lg-3">
					<div class="card h-100 shadow-sm">
						<div class="card-body d-flex flex-column align-items-center text-center">
							@if (file.IsImage)
							{
								<img src="@file.PublicUrl"
									 alt="@file.FileName"
									 class="img-fluid mb-2"
									 style="max-height: 160px; border: 1px solid #eee; border-radius: 6px;" />
							}
							else
							{
								<div class="display-4 text-danger mb-2">
									<i class="bi bi-filetype-pdf"></i>
								</div>
							}
							<div class="w-100 text-truncate" title="@file.FileName">@file.FileName</div>
							<small class="text-muted">@file.LastModified.ToString("yyyy-MM-dd HH:mm")</small>
							<button class="btn btn-primary btn-sm mt-2 w-100" @onclick="@(() => OpenInPopup(file))">
								<i class="bi bi-arrows-fullscreen me-1"></i>View
							</button>
						</div>
					</div>
				</div>
			}
		</div>

		<div class="d-flex justify-content-between align-items-center mt-3">
			<button class="btn btn-outline-secondary btn-sm" @onclick="PrevPage" disabled="@(_pageIndex == 0)">
				<i class="bi bi-chevron-left"></i> Prev
			</button>
			<span>Page @(_pageIndex + 1) of @_totalPages</span>
			<button class="btn btn-outline-secondary btn-sm" @onclick="NextPage" disabled="@(_pageIndex >= _totalPages - 1)">
				Next <i class="bi bi-chevron-right"></i>
			</button>
		</div>
	}
}

<Popup IsOpen="@showPreviewPopup"
	   IsOpenChanged="@((bool open) => showPreviewPopup = open)"
	   Title="@popupTitle"
	   CloseOnBackdropClick="true">
	<div class="text-center">
		@if (!string.IsNullOrEmpty(popupUrl))
		{
			@if (popupIsImage)
			{
				<img src="@popupUrl" alt="@popupTitle" class="img-fluid"
					 style="max-width: 100%; max-height: 80vh; border-radius: 8px;" />
			}
			@* Render PDF using object/embed *@
			else
			{
				<object data="@popupUrl" type="application/pdf" width="100%" height="80vh">
					<p>Your browser cannot display PDFs. You can download it instead.</p>
				</object>
			}
		}
	</div>
</Popup>

@code {
	private bool isLoading = true;

	private List<InvoiceFile> invoiceFiles = new();
	private IEnumerable<InvoiceFile> pagedFiles => invoiceFiles.Skip(_pageIndex * _pageSize).Take(_pageSize);
	private int _pageIndex = 0;
	private int _pageSize = 24;
	private int _totalPages = 0;

	private bool showPreviewPopup = false;
	private string popupTitle = "";
	private string popupUrl = "";
	private bool popupIsImage = false;

	protected override async Task OnInitializedAsync()
	{
		await LoadInvoicesAsync();
	}

	private async Task LoadInvoicesAsync()
	{
		try
		{
			isLoading = true;
			invoiceFiles.Clear();

			var invoiceFolderPath = InvoicePaths.Resolve(Configuration);
			if (string.IsNullOrWhiteSpace(invoiceFolderPath) || !Directory.Exists(invoiceFolderPath))
			{
				_totalPages = 0;
				return;
			}

			var allowedExtensions = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { ".png", ".jpg", ".jpeg", ".pdf" };
			var files = Directory.EnumerateFiles(invoiceFolderPath)
				.Where(p => allowedExtensions.Contains(Path.GetExtension(p)))
				.OrderByDescending(File.GetLastWriteTimeUtc)
				.ToList();

			foreach (var path in files)
			{
				var ext = Path.GetExtension(path).ToLowerInvariant();
				var isImage = ext == ".png" || ext == ".jpg" || ext == ".jpeg";
				var name = Path.GetFileName(path);
				var safe = Uri.EscapeDataString(name);

				invoiceFiles.Add(new InvoiceFile
				{
					FileName = name,
					FullPath = path,
					Extension = ext,
					LastModified = File.GetLastWriteTime(path),
					IsImage = isImage,
					PublicUrl = $"/invoices/{safe}"
				});
			}

			_totalPages = (int)Math.Ceiling(invoiceFiles.Count / (double)_pageSize);
		}
		finally
		{
			isLoading = false;
			StateHasChanged();
		}
	}

	private Task OpenInPopup(InvoiceFile file)
	{
		popupTitle = file.FileName;
		popupUrl = file.PublicUrl;
		popupIsImage = file.IsImage;
		showPreviewPopup = true;
		return Task.CompletedTask;
	}

	private class InvoiceFile
	{
		public string FileName { get; set; } = "";
		public string FullPath { get; set; } = "";
		public string Extension { get; set; } = "";
		public DateTime LastModified { get; set; }
		public bool IsImage { get; set; }
		public string PublicUrl { get; set; } = "";
	}

	private void NextPage()
	{
		if (_pageIndex < _totalPages - 1) _pageIndex++;
	}

	private void PrevPage()
	{
		if (_pageIndex > 0) _pageIndex--;
	}
}


