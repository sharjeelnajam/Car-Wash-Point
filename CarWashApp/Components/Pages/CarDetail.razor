@page "/car-detail/{licensePlate}"
@using CarWashApp.Models
@using CarWashApp.Models.DTOs
@using CarWashApp.Services
<h3>CarDetail</h3>

@if (car == null)
{
    <div class="alert alert-danger">Car not found!</div>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <h4>@car.Name </h4>
            <p>
                <strong>License Plate:</strong> @car.LicensePlate <br />
                <strong>Color:</strong> @car.Color <br />
                <strong>Loyalty Points:</strong> @car.LoyaltyPoints
            </p>
            <button class="btn btn-success" @onclick="GoToSelectService">Select Service</button>
        </div>
    </div>
}

@code {
    [Parameter] public string licensePlate { get; set; }
    [Inject] NavigationManager NavigationManager { get; set; }
    [Inject] ICarService CarService { get; set; }

    private CarDto car;

    protected override void OnInitialized()
    {
        try
        {
            // Load car by license plate
            car = CarService.GetAllCars().Find(car => car.LicensePlate == licensePlate);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading car: {ex.Message}");
            car = null; // Set to null if not found or error occurs
        }
    }



    void GoToSelectService()
    {
        var carData = System.Text.Json.JsonSerializer.Serialize(car);
        NavigationManager.NavigateTo($"services?car={Uri.EscapeDataString(carData)}");
    }
}
