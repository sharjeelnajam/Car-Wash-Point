@page "/car-details"
@using CarWashApp.Models

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-12">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0"><i class="bi bi-car-front-fill me-2"></i>Car Wash Models & Pricing</h3>
                </div>
                <div class="card-body">
                    @if (cars == null)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-3">Loading car models...</p>
                        </div>
                    }
                    else if (!cars.Any())
                    {
                        <div class="alert alert-info text-center">No car models available.</div>
                    }
                    else
                    {
                        <table class="table table-hover table-bordered align-middle" style="font-size:1.5rem;">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:35%;">Name</th>
                                    <th style="width:35%;">Model</th>
                                    <th style="width:30%;">Wash Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var car in cars)
                                {
                                    <tr>
                                        <td class="py-3"><i class="bi bi-car-front me-2 text-secondary"></i>@car.Name</td>
                                        <td class="py-3">@car.LicensePlate</td>
                                        <td class="py-3"><button @onclick="GoToPayment" class="badge bg-success fs-4">$25</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Car> cars;

    // [Inject] HttpClient HttpClient { get; set; }
    [Inject] NavigationManager NavigationManager { get; set; }

    protected override async Task OnInitializedAsync()
    {
        cars = DummyCars.GetCars();
    }

    void GoToPayment() => NavigationManager.NavigateTo("/payment");
}
