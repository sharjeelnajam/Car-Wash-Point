@page "/car-registration"
@using System.ComponentModel.DataAnnotations
@using CarWashApp.Models
@using CarWashApp.Models.DTOs
@using CarWashApp.Services
@inject NavigationManager NavigationManager

<EditForm Model="@car" OnSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="container mt-4">
        <h2>Car Registration</h2>

        <!-- License Plate -->
        <div class="mb-3">
            <label class="form-label">License Plate <span class="text-danger">*</span></label>
            <InputText @bind-Value="car.LicensePlate"
                       class="form-control me-2 uppercase-input"
                       type="search"
                       placeholder="License Number..."
                       oninput="this.value = this.value.toUpperCase()" />

            <ValidationMessage For="@(() => car.LicensePlate)" />
        </div>

        <!-- Name -->
        <div class="mb-3">
            <label class="form-label">Car Name <span class="text-danger">*</span></label>
            <InputText class="form-control" @bind-Value="car.Name" />
            <ValidationMessage For="@(() => car.Name)" />
        </div>

        <!-- Color -->
        <div class="mb-3">
            <label class="form-label">Color</label>
            <InputText class="form-control" @bind-Value="car.Color" />
            <ValidationMessage For="@(() => car.Color)" />
        </div>

        <!-- Loyalty Points -->
        <div class="mb-3">
            <label class="form-label">Loyalty Points</label>
            <InputNumber class="form-control" @bind-Value="car.LoyaltyPoints" />
            <ValidationMessage For="@(() => car.LoyaltyPoints)" />
        </div>

        <button type="submit" class="btn btn-primary">Register Car</button>
        <button type="button" @onclick="GoBack" class="btn btn-primary">Back</button>
    </div>
</EditForm>

@code {
    [Inject] ICarService CarService { get; set; }
    [Inject] IJSRuntime JS { get; set; }

    private CarDto car = new CarDto();

    private void HandleValidSubmit()
    {
        // You can save to database or call an API here
        Console.WriteLine($"Car Registered: {car.LicensePlate} - {car.Name}");
        CarService.AddCar(car);
        NavigationManager.NavigateTo($"car-detail/{car.LicensePlate}"); // Navigate to car list or confirmation
    }
    private async Task GoBack()
    {
        var canGoBack = await JS.InvokeAsync<bool>("eval", "history.length > 1");
        if (canGoBack)
            await JS.InvokeVoidAsync("navigationHelper.goBack");
        else
            NavigationManager.NavigateTo("/"); // fallback to home
    }

}
