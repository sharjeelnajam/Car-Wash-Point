    private void LogScannerEvent(string message, Exception? ex = null)
    {
        try
        {
            var logMessage = $"[Payment] {message}";
            if (ex is not null)
            {
                logMessage += $" | Exception: {ex}";
            }
            LogService.Log(logMessage);
        }
        catch
        {
            // Ignore logging failures
        }
    }

    private async Task<bool> WaitForImageFileAsync(string filePath, int maxAttempts = 20, int delayMs = 150)
    {
        for (int attempt = 1; attempt <= maxAttempts; attempt++)
        {
            if (File.Exists(filePath))
            {
                LogScannerEvent($"WaitForImageFileAsync detected file on attempt {attempt}.");
                return true;
            }

            LogScannerEvent($"WaitForImageFileAsync attempt {attempt} - file not found.");
            await Task.Delay(delayMs);
        }

        LogScannerEvent("WaitForImageFileAsync exhausted retries without finding the file.", null);
        return false;
    }

    private void LoadImageFromPath(string filePath)
    {
        try
        {
            if (File.Exists(filePath))
            {
                byte[] imageBytes = File.ReadAllBytes(filePath);
                string base64String = Convert.ToBase64String(imageBytes);
                ImageDataUri = $"data:image/png;base64,{base64String}";
                StateHasChanged();
                LogScannerEvent($"Preview image loaded from '{filePath}'.");
            }
            else
            {
                ImageDataUri = null;
                ToastService.ShowError("File not exits");
                LogScannerEvent($"LoadImageFromPath could not find file '{filePath}'.");
            }
        }
        catch (Exception ex)
        {
            ImageDataUri = null;
            ToastService.ShowError($"Error loading image: {ex.Message}");
            LogScannerEvent($"LoadImageFromPath threw an exception for '{filePath}'.", ex);
        }
    }

    private async Task RetryCapture()
    {
        var invoiceFolderPath = Configuration["InvoicePath"];
        var file = Path.Combine(invoiceFolderPath, LastCapturedImage);
        try
        {
            if (File.Exists(file))
            {
                File.Delete(file);
            }
            await TestCapture();
        }
        catch(Exception e)
        {
            LogScannerEvent($"Retry Capture failed for {file}", e);
        }
    }

    private async Task OpenScanner()
    {
        isOpeningScanner = true;
        LogScannerEvent("OpenScanner invoked.");
        
        try
        {
            // Check if scanner is already open
            if (scannerIsOpen)
            {
                ToastService.ShowWarning("Scanner is already open. No action needed.");
                LogScannerEvent("OpenScanner attempted but scanner is already open.");
                return;
            }

            // Check if scanner is connected
            bool isConnected = ScannerService.IsScannerConnected();
            if (!isConnected)
            {
                ToastService.ShowError("No scanner device detected. Please connect a scanner and try again.");
                LogScannerEvent("OpenScanner failed: No scanner device detected.");
                return;
            }

            LogScannerEvent("Attempting to open scanner...");
            bool result = ScannerService.OpenScanner();

            if (result)
            {
                scannerIsOpen = true;
                ToastService.ShowSuccess("Scanner opened successfully! ✅");
                LogScannerEvent("Scanner opened successfully.");
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("Failed to open scanner. Please check the device connection and try again.");
                LogScannerEvent("OpenScanner failed: ScannerService.OpenScanner returned false.");
            }
        }
        catch (Exception ex)
        {
            // If exception occurs, assume scanner is already opened
            scannerIsOpen = true;
            ToastService.ShowInfo("Scanner may already be open. Assuming scanner is ready to use.");
            LogScannerEvent("OpenScanner threw an exception. Assuming scanner is already opened.", ex);
        }
        finally
        {
            isOpeningScanner = false;
            LogScannerEvent("OpenScanner finished.");
        }
    }

    async Task ProcessCardPayment()
    {
        try
        {
            ToastService.ShowInfo("Processing card payment...");
            LogScannerEvent("ProcessCardPayment started.");

            // Add transaction record immediately for card payment
            var description = redemptionType switch
            {
                LoyaltyRedemptionType.FreeWash => $"FREE wash for {GetCarInfo()} (redeemed 10 loyalty points)",
                LoyaltyRedemptionType.HalfPrice => $"Paid {carWashCharges:C} using Card for {GetCarInfo()} (redeemed 5 loyalty points - was {originalAmount:C})",
                _ => $"Paid {carWashCharges:C} using Card for {GetCarInfo()} (earned 1 loyalty point)"
            };
            
            var dto = new TransactionDto
            {
                Amount = carWashCharges,
                Date = DateTime.UtcNow,
                Description = description,
                PaymentMethod = PaymentMethod.Card
            };
            TransactionService.AddTransaction(dto);
            LogScannerEvent("Transaction entry added for card payment.");

            // Handle loyalty points logic
            await HandleLoyaltyPoints();
            LogScannerEvent("Loyalty points handled for card payment.");
            
            // Update invoice with actual payment data
            UpdateInvoiceData();
            LogScannerEvent("Invoice data updated for card payment.");
            
            // Generate PDF and show popup
            pdfBytes = await InvoiceService.GenerateInvoice(invoiceDto);
            showInvoicePopup = true;
            isPaymentSelected = false; // Reset payment selection
            
            // Show success message
            ToastService.ShowSuccess("Card payment processed successfully!");
            
            StateHasChanged(); // Refresh UI to show popup
            LogScannerEvent("ProcessCardPayment completed successfully.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Card payment error: {ex.Message}");
            LogScannerEvent("ProcessCardPayment failed.", ex);
        }
    }

    async Task CancelPayment()
    {
        LogScannerEvent("CancelPayment invoked.");
        isCancellingPayment = true;
        try
        {
            // Handle card / split (scanner) cancellation without hitting cash device API
            if (selectedPaymentMethod == PaymentMethod.Card)
            {
                ToastService.ShowInfo("Cancelling card payment...");
                
                // Reset scanner state if open
                if (scannerIsOpen)
                {
                    LogScannerEvent("Resetting scanner state during card payment cancellation.");
                    scannerIsOpen = false;
                }
                
                ToastService.ShowSuccess("Card payment cancelled successfully!");
                LogScannerEvent("Card payment cancellation completed.");
                isPaymentSelected = false; // Reset payment selection
                return;
            }

            if (selectedPaymentMethod == PaymentMethod.Split)
            {
                ToastService.ShowInfo("Cancelling split payment...");
                if (scannerIsOpen)
                {
                    scannerIsOpen = false;
                }

                var splitCancelResult = await ApiClient.CancelPaymentSafely();
                if (splitCancelResult.Success)
                    ToastService.ShowSuccess(splitCancelResult.Message);
                else
                    ToastService.ShowWarning(splitCancelResult.Message);

                isPaymentSelected = false;
                return;
            }

            // Handle cash payment cancellation (existing logic)
            ToastService.ShowInfo("Cancelling payment...");

            // Use the new safe cancel method
            var result = await ApiClient.CancelPaymentSafely();

            if (result.Success)
            {
                ToastService.ShowSuccess(result.Message);
                LogScannerEvent("Cash payment cancellation succeeded.");
                // NavigationManager.NavigateTo("/");
            }
            else
            {
                ToastService.ShowWarning(result.Message);
                LogScannerEvent($"Cash payment cancellation reported warning: {result.Message}");
            }

            // Reset payment selection regardless of success/failure
            isPaymentSelected = false;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Cancel payment error: {ex.Message}");
            // Still reset payment selection on error
            isPaymentSelected = false;
            LogScannerEvent("CancelPayment threw an exception.", ex);
        }
        finally
        {
            isCancellingPayment = false;
            LogScannerEvent("CancelPayment finished.");
        }
    }

