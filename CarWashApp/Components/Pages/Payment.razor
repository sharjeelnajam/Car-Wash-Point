@page "/payment"
@using Blazored.Toast.Configuration
@using Blazored.Toast.Services
@using CarWashApp.Models
@using CarWashApp.Models.DTOs
@using CarWashApp.Responses.Status
@using CarWashApp.Services
@using CarWashApp.Services.HttpClientServices
@using System.Text.Json
@using System.Text
@using CarWashApp.Services.Scanner
@using Microsoft.AspNetCore.WebUtilities
@using CarWashApp.Components.Shared

<button class="btn btn-lg btn-primary" @onclick="@(() => NavigationManager.NavigateTo("/"))"> Home</button>

@if (isPaymentSelected)
{
    <div class="container d-flex justify-content-center align-items-center"
         style="overflow: hidden;">

        <div class="card shadow-lg p-5 text-center"
             style="max-width: 500px; border-radius: 20px;">

            @* <h2 class="mb-4" style="font-size: 2rem; font-weight: bold;">
                Charges for car wash: <span style="color: #007bff;">@carWashCharges €</span>
            </h2> *@

            <p class="mb-3" style="font-size: 1.5rem; font-weight: 500;">
                Amount To Pay:
            </p>

            <InputNumber @bind-Value="CarWashCharges"
                         type="number"
                         step="0.01"
                         class="form-control form-control-lg text-center"
                         placeholder="Enter amount"
                         style="font-size: 1.5rem; border-radius: 12px;"
                         readonly />


            <div class="mt-4 d-flex gap-2 justify-content-center flex-wrap">
                <button @onclick="ProcessPayment"
                        class="btn btn-success btn-lg"
                        disabled="@(isProcessingPayment || isCancellingPayment)">
                    @if (isProcessingPayment)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        @:Processing...
                    }
                    else
                    {
                        <i class="bi bi-credit-card me-2"></i>
                        @:Process Payment
                    }
                </button>

                <button @onclick="CancelPayment"
                        class="btn btn-warning btn-lg"
                        disabled="@(isCancellingPayment)">
                    @if (isCancellingPayment)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        @:Cancelling...
                    }
                    else
                    {
                        <i class="bi bi-x-circle me-2"></i>
                        @:Cancel Session
                    }
                </button>

                @* <button @onclick="CloseSession" 
                        class="btn btn-secondary btn-lg" 
                        disabled="@(isProcessingPayment || isCancellingPayment || isClosingSession)">
                    @if (isClosingSession)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        @:Closing...
                    }
                    else
                    {
                        <i class="bi bi-door-closed me-2"></i>
                        @:Close Session
                    }
                </button> *@
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ImageDataUri))
    {
        <div class="container mt-4">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <div class="card shadow-lg">
                        <div class="card-header bg-info text-white text-center">
                            <h4 class="mb-0"><i class="bi bi-image me-2"></i>Captured Invoice Image</h4>
                        </div>
                        <div class="card-body text-center">
                            <div class="mb-3">
                                <img src="@ImageDataUri"
                                     alt="Captured Invoice"
                                     class="img-fluid"
                                     style="max-width: 100%; max-height: 600px; height: auto; border: 2px solid #ddd; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);" />
                            </div>
                            @if (!string.IsNullOrEmpty(LastCapturedImage))
                            {
                                <div class="mt-2">
                                    <small class="text-muted">
                                        <i class="bi bi-file-image me-1"></i>Filename: @LastCapturedImage
                                    </small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <!-- Vehicle Information Card -->
                @if (selectedCar != null)
                {
                    <div class="card mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="bi bi-car-front me-2"></i>Selected Vehicle</h5>
                        </div>
                        <div class="card-body">
                            <p class="mb-1"><strong>Car:</strong> @selectedCar.Name</p>
                            <p class="mb-1"><strong>License Plate:</strong> @selectedCar.LicensePlate</p>
                            <p class="mb-0"><strong>Available Points:</strong> <span class="badge bg-warning text-dark">@selectedCar.LoyaltyPoints points</span></p>
                        </div>
                    </div>
                }
                else if (selectedVehicle != null)
                {
                    <div class="card mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="bi bi-car-front me-2"></i>Selected Service</h5>
                        </div>
                        <div class="card-body">
                            <p class="mb-1"><strong>Vehicle:</strong> @selectedVehicle.Title</p>
                            @if (!string.IsNullOrEmpty(selectedVehicle.VanSize))
                            {
                                <p class="mb-1"><strong>Van Size:</strong> @selectedVehicle.VanSize</p>
                            }
                            @if (!string.IsNullOrEmpty(selectedVehicle.WashPackage))
                            {
                                <p class="mb-1"><strong>Wash Package:</strong> @GetWashPackageName(selectedVehicle.WashPackage)</p>
                            }
                            @if (selectedVehicle.AddOns?.Any() == true)
                            {
                                <p class="mb-1"><strong>Add-ons:</strong></p>
                                <ul class="mb-1">
                                    @foreach (var addon in selectedVehicle.AddOns)
                                    {
                                        <li>@GetAddOnName(addon)</li>
                                    }
                                </ul>
                            }
                            @if (selectedVehicle.DirtyCharge > 0)
                            {
                                <p class="mb-1"><strong>Dirty Car Charge:</strong> +£@selectedVehicle.DirtyCharge.ToString("F2")</p>
                            }
                            <p class="mb-0"><strong>Total Amount:</strong> <span class="badge bg-success text-white">£@selectedVehicle.Amount.ToString("F2")</span></p>
                        </div>
                    </div>
                }

                <!-- Amount Input Section -->
                @if (selectedCar != null || selectedVehicle != null)
                {
                    <div class="card mb-4">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0"><i class="bi bi-calculator me-2"></i>Enter Amount</h5>
                        </div>
                        <div class="card-body text-center">
                            <p class="mb-3">Enter the amount for your car wash service:</p>
                            <div class="mb-3">
                                <InputNumber @bind-Value="carWashCharges"
                                           type="number"
                                           step="0.01"
                                           class="form-control form-control-lg text-center"
                                           placeholder="Enter amount"
                                           style="font-size: 1.2rem; border-radius: 8px;"
                                           readonly />
                            </div>
                            <small class="text-muted">Minimum amount: $5.00</small>
                        </div>
                    </div>
                }

                <!-- Loyalty Points Redemption Options - Only show if car data is available -->
                @if (selectedCar != null)
                {
                    <div class="card mb-4">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0"><i class="bi bi-star-fill me-2"></i>Loyalty Points Redemption</h5>
                        </div>
                        <div class="card-body text-center">
                            <p class="mb-3">You have <strong>@selectedCar.LoyaltyPoints points</strong> available!</p>
                            <p class="mb-3 text-muted">Amount: <strong>$@carWashCharges.ToString("F2")</strong></p>
                                <div class="d-flex flex-column gap-3 align-items-center">
                                @if (selectedCar.LoyaltyPoints >= 5)
                                {
                                    var currentAmount = carWashCharges > 0 ? carWashCharges : (originalAmount > 0 ? originalAmount : 0);
                                    var discountAmount = currentAmount / 2;
                                    <button @onclick="@(() => SelectLoyaltyRedemption(LoyaltyRedemptionType.HalfPrice))"
                                            class="btn btn-warning btn-lg w-75 @(redemptionType == LoyaltyRedemptionType.HalfPrice ? "border-primary" : "")"
                                            style="border-width: 3px;" title="Use 5 points for 50% off">
                                        <i class="bi bi-star me-2"></i>
                                        5 Points = 50% OFF<br>
                                        <small>Pay $@discountAmount.ToString("F2") instead of $@currentAmount.ToString("F2")</small>
                                    </button>
                                }
                                
                                @if (selectedCar.LoyaltyPoints >= 10)
                                {
                                    <button @onclick="@(() => SelectLoyaltyRedemption(LoyaltyRedemptionType.FreeWash))"
                                            class="btn btn-success btn-lg w-75 @(redemptionType == LoyaltyRedemptionType.FreeWash ? "border-primary" : "")"
                                            style="border-width: 3px;" title="Use 10 points for free wash">
                                        <i class="bi bi-gift me-2"></i>
                                        10 Points = FREE WASH<br>
                                        <small>No payment required! (Was $@carWashCharges.ToString("F2"))</small>
                                    </button>
                                }
                                

                                @if (selectedCar.LoyaltyPoints < 5)
                                {
                                    <div class="alert alert-info mt-3">
                                        <i class="bi bi-info-circle me-2"></i>
                                        <strong>Need more points!</strong> Earn @(5 - selectedCar.LoyaltyPoints) more point(s) to unlock 50% off redemption.
                                        Pay full price today to earn 1 loyalty point!
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (selectedVehicle != null)
                {
                    <div class="card mb-4">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Loyalty Points Information</h5>
                        </div>
                        <div class="card-body text-center">
                            <p class="mb-3">To use loyalty points, please select a registered vehicle first.</p>
                            <p class="mb-3 text-muted">Amount: <strong>£@carWashCharges.ToString("F2")</strong></p>
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>
                                <strong>Want to earn loyalty points?</strong> Register your vehicle to start earning points with each wash!
                            </div>
                        </div>
                    </div>
                }

                <div class="card shadow-lg">
                    <div class="card-header bg-success text-white text-center">
                        <h3 class="mb-0"><i class="bi bi-credit-card-2-front-fill me-2"></i>Payment Options</h3>
                    </div>
                    <div class="card-body text-center">
                        <p class="lead mb-4">Select your preferred payment method:</p>
                        <div class="d-flex flex-column gap-4 align-items-center">
                            <button @onclick=@(() => PaymentMethodSelected(PaymentMethod.Cash))
                                    class="btn btn-primary btn-lg w-75" type="button">
                                <i class="bi bi-cash-coin me-2"></i>Cash
                            </button>
                            <button @onclick=@(() => PaymentMethodSelected(PaymentMethod.Card))
                                    class="btn btn-info btn-lg w-75 text-white" type="button">
                                <i class="bi bi-credit-card-2-front me-2"></i>Card
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
}
<Popup IsOpen="@showInvoicePopup"
       IsOpenChanged="@((bool isOpen) => showInvoicePopup = isOpen)"
       Title="Invoice - Payment Complete"
       CloseOnBackdropClick="true">
    <div class="text-center">
        @if (pdfBytes != null)
        {
            <div class="mb-3">
                <p class="lead">Your payment has been processed successfully!</p>
                <p class="text-muted">Invoice #@invoiceDto.InvoiceNumber</p>
            </div>

            <div class="d-flex flex-column gap-3 align-items-center">
                <button @onclick="ViewPdfInBrowser"
                        class="btn btn-primary btn-lg w-75">
                    <i class="bi bi-eye me-2"></i>View Invoice
                </button>

                <button @onclick="DownloadPdfFromPopup"
                        class="btn btn-success btn-lg w-75">
                    <i class="bi bi-download me-2"></i>Download PDF
                </button>

                <button @onclick="@(() => showInvoicePopup = false)"
                        class="btn btn-secondary w-75">
                    <i class="bi bi-x-circle me-2"></i>Close
                </button>
            </div>
        }
        else
        {
            <div class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Generating invoice...</span>
                </div>
                <p class="mt-2">Generating your invoice...</p>
            </div>
        }
    </div>
</Popup>

@code {
    [Inject] IToastService ToastService { get; set; }
    [Inject] CWPClient ApiClient { get; set; }
    [Inject] ITransactionService TransactionService { get; set; }
    [Inject] NavigationManager NavigationManager { get; set; }
    [Inject] InvoiceService InvoiceService { get; set; }
    [Inject] IJSRuntime JS { get; set; }
    [Inject] ICarService CarService { get; set; }

    public class VehicleType
    {
        public string Title { get; set; } = "";
        public string? Subtitle { get; set; }
        public string? Description { get; set; }
        public string? IconUrl { get; set; }
        public decimal Amount { get; set; }
        public string VanSize { get; set; } = "";
        public string WashPackage { get; set; } = "";
        public List<string> AddOns { get; set; } = new();
        public decimal DirtyCharge { get; set; } = 0m;
    }

    bool isPaymentSelected = false;
    bool isProcessingPayment = false;
    bool isCancellingPayment = false;
    bool showInvoicePopup = false;
    private decimal carWashCharges;
    private CarDto selectedCar;
    private VehicleType selectedVehicle;
    private bool useLoyaltyRedemption = false;
    private LoyaltyRedemptionType redemptionType = LoyaltyRedemptionType.None;
    private decimal originalAmount = 0m;

    decimal CarWashCharges
    {
        get => carWashCharges;
        set
        {
            if (value < 0)
            {
                carWashCharges = 0;
            }
            else
            {
                value = Math.Truncate(value * 100) / 100;
                carWashCharges = value;

                // Store the user-entered amount as original amount if it's valid
                if (value >= 5)
                {
                    originalAmount = value;
                }

                // Force UI refresh to update loyalty calculations
                StateHasChanged();
            }
        }
    }

    byte[] pdfBytes;

    InvoiceDto invoiceDto = new()
    {
        CustomerName = "Test Customer",
        CustomerEmail = "customer@email.com",
        CustomerPhone = "+1234567890",
        VehicleType = "Car",
        LicensePlate = "ABC123",
        InvoiceNumber = $"INV-{DateTime.Now:yyyy-MM-dd-HHmmss}",
        InvoiceDate = DateTime.Now,
        ServiceItems = new List<ServiceItem>
        {
            new ServiceItem { Description = "Car Wash Service", Quantity = 1, UnitPrice = 0m, TotalPrice = 0m }
        },
        Subtotal = 0m,
        TaxRate = 0.20m,
        TaxAmount = 0m,
        TotalAmount = 0m,
        PaymentMethod = "Cash",
        Notes = "Car wash service completed successfully."
    };

    PaymentMethod selectedPaymentMethod;
    Task PaymentMethodSelected(PaymentMethod method)
    {
        selectedPaymentMethod = method;

        // Store original amount when payment method is first selected
        if (originalAmount == 0)
        {
            originalAmount = carWashCharges;
        }

        isPaymentSelected = true;
        StateHasChanged(); // Trigger UI refresh to show loyalty options
        return Task.CompletedTask;
    }


    async Task ProcessPayment()
    {
        isProcessingPayment = true;
        try
        {
            // Handle card payments differently from cash payments
            if (selectedPaymentMethod == PaymentMethod.Card)
            {
                // await ProcessCardPayment();
                await CaptureImage();
                return;
            }

            // Handle cash payments (existing logic)
            ToastService.ShowInfo("Starting payment...");

            // Use the new safe payment method
            var result = await ApiClient.StartPaymentSafely(carWashCharges * 100);

            if (result.Success)
            {
                // Payment started successfully
                ToastService.ShowSuccess(result.Message);

                // Add transaction record
                var description = redemptionType switch
                {
                    LoyaltyRedemptionType.FreeWash => $"FREE wash for {GetCarInfo()} (redeemed 10 loyalty points)",
                    LoyaltyRedemptionType.HalfPrice => $"Paid {carWashCharges:C} using {selectedPaymentMethod.ToString()} for {GetCarInfo()} (redeemed 5 loyalty points - was {originalAmount:C})",
                    _ => $"Paid {carWashCharges:C} using {selectedPaymentMethod.ToString()} for {GetCarInfo()} (earned 1 loyalty point)"
                };

                var dto = new TransactionDto
                {
                    Amount = carWashCharges,
                    Date = DateTime.UtcNow,
                    Description = description,
                    PaymentMethod = selectedPaymentMethod
                };
                TransactionService.AddTransaction(dto);

                // Monitor payment status
                while (true)
                {
                    var status = await ApiClient.CheckPaymentStatus();
                    var latestEvent = status?.Events?.LastOrDefault();

                    if (latestEvent != null)
                    {
                        if (Enum.TryParse(latestEvent.EventType, out EventType latestEventType))
                        {
                            switch (latestEventType)
                            {
                                case EventType.Waiting:
                                    ToastService.ShowInfo("Payment session is active and waiting for cash.");
                                    break;
                                case EventType.PaymentComplete:
                                    ToastService.ShowSuccess("Payment completed successfully!");

                                    // Handle loyalty points logic
                                    await HandleLoyaltyPoints();

                                    // Update invoice with actual payment data
                                    UpdateInvoiceData();

                                    // Generate PDF and show popup
                                    pdfBytes = await InvoiceService.GenerateInvoice(invoiceDto);
                                    showInvoicePopup = true;
                                    isPaymentSelected = false; // Reset payment selection
                                    StateHasChanged(); // Refresh UI to show popup
                                    return;
                                case EventType.CancelComplete:
                                    ToastService.ShowWarning("Payment was canceled.");
                                    isPaymentSelected = false; // Reset payment selection 
                                    return;
                                case EventType.StoppingPayment:
                                    ToastService.ShowWarning("Payment is stopping...");
                                    break;
                                case EventType.Idle:
                                    isPaymentSelected = false; // Reset payment selection
                                    return;
                                default:
                                    ToastService.ShowInfo($"Payment in progress... Current status: {latestEventType}");
                                    break;
                            }
                        }
                    }

                    // Add a delay to prevent rapid, unnecessary polling
                    await Task.Delay(3000);
                }
            }
            else
            {
                // Payment failed
                ToastService.ShowError(result.Message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Payment error: {ex.Message}");
        }
        finally
        {
            isProcessingPayment = false;
        }
    }
    [Inject] IConfiguration Configuration { get; set; }
    [Inject] ScannerService ScannerService { get; set; }
    async Task CaptureImage()
    {
        var invoiceFolderPath = Configuration["InvoicePath"];

        if (string.IsNullOrWhiteSpace(invoiceFolderPath))
            throw new Exception("Invoice folder path is not configured.");

        // Ensure folder exists
        if (!Directory.Exists(invoiceFolderPath))
            Directory.CreateDirectory(invoiceFolderPath);

        // Create invoice file name
        string invoiceFileName = $"INV-{DateTime.Now:yyyyMMddHHmmss}.png";

        // Full save path
        string invoicePath = Path.Combine(invoiceFolderPath, invoiceFileName);
        ScannerService.OpenScanner();
        string? output = ScannerService.ScanInvoice(invoicePath);
        ScannerService.CloseScanner();

        if (output != null)
        {
            // Store the filename
            LastCapturedImage = invoiceFileName;

            // Load and display the image directly
            LoadImageFromPath(invoicePath);

            ToastService.ShowSuccess("Image Captured ");
        }
        else
        {
            ToastService.ShowError("Capture Failed");
        }
    }
    private string? ImageDataUri;
    private string? LastCapturedImage;

    private void LoadImageFromPath(string filePath)
    {
        try
        {
            if (File.Exists(filePath))
            {
                byte[] imageBytes = File.ReadAllBytes(filePath);
                string base64String = Convert.ToBase64String(imageBytes);
                ImageDataUri = $"data:image/png;base64,{base64String}";
                StateHasChanged();
            }
            else
            {
                ImageDataUri = null;
                ToastService.ShowError("File not exits");
            }
        }
        catch (Exception ex)
        {
            ImageDataUri = null;
            ToastService.ShowError($"Error loading image: {ex.Message}");
        }
    }
    async Task ProcessCardPayment()
    {
        try
        {
            ToastService.ShowInfo("Processing card payment...");

            // Add transaction record immediately for card payment
            var description = redemptionType switch
            {
                LoyaltyRedemptionType.FreeWash => $"FREE wash for {GetCarInfo()} (redeemed 10 loyalty points)",
                LoyaltyRedemptionType.HalfPrice => $"Paid {carWashCharges:C} using Card for {GetCarInfo()} (redeemed 5 loyalty points - was {originalAmount:C})",
                _ => $"Paid {carWashCharges:C} using Card for {GetCarInfo()} (earned 1 loyalty point)"
            };
            
            var dto = new TransactionDto
            {
                Amount = carWashCharges,
                Date = DateTime.UtcNow,
                Description = description,
                PaymentMethod = PaymentMethod.Card
            };
            TransactionService.AddTransaction(dto);

            // Handle loyalty points logic
            await HandleLoyaltyPoints();
            
            // Update invoice with actual payment data
            UpdateInvoiceData();
            
            // Generate PDF and show popup
            pdfBytes = await InvoiceService.GenerateInvoice(invoiceDto);
            showInvoicePopup = true;
            isPaymentSelected = false; // Reset payment selection
            
            // Show success message
            ToastService.ShowSuccess("Card payment processed successfully!");
            
            StateHasChanged(); // Refresh UI to show popup
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Card payment error: {ex.Message}");
        }
    }

    async Task CancelPayment()
    {
        isCancellingPayment = true;
        try
        {
            // Handle card payment cancellation differently
            if (selectedPaymentMethod == PaymentMethod.Card)
            {
                ToastService.ShowInfo("Cancelling card payment...");
                ToastService.ShowSuccess("Card payment cancelled successfully!");
                isPaymentSelected = false; // Reset payment selection
                return;
            }

            // Handle cash payment cancellation (existing logic)
            ToastService.ShowInfo("Cancelling payment...");

            // Use the new safe cancel method
            var result = await ApiClient.CancelPaymentSafely();

            if (result.Success)
            {
                ToastService.ShowSuccess(result.Message);
                // NavigationManager.NavigateTo("/");
            }
            else
            {
                ToastService.ShowWarning(result.Message);
            }

            // Reset payment selection regardless of success/failure
            isPaymentSelected = false;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Cancel payment error: {ex.Message}");
            // Still reset payment selection on error
            isPaymentSelected = false;
        }
        finally
        {
            isCancellingPayment = false;
        }
    }

    private async Task DownloadPdf()
    {
        // Update invoice with current payment data
        UpdateInvoiceData();
        
        var pdfBytes = await InvoiceService.GenerateInvoice(invoiceDto);

        if(pdfBytes is not null)
        {
            string base64 = Convert.ToBase64String(pdfBytes);

            await JS.InvokeVoidAsync("downloadHelper", "Invoice.pdf", "application/pdf", base64);
        }
    }

    private async Task ViewPdfInBrowser()
    {
        if (pdfBytes != null)
        {
            string base64 = Convert.ToBase64String(pdfBytes);
            string dataUrl = $"data:application/pdf;base64,{base64}";
            
            // Open PDF in new browser tab using window.open
            await JS.InvokeVoidAsync("eval", $"window.open('{dataUrl}', '_blank')");
        }
    }

    private async Task DownloadPdfFromPopup()
    {
        if (pdfBytes != null)
        {
            string base64 = Convert.ToBase64String(pdfBytes);
            await JS.InvokeVoidAsync("downloadHelper", $"Invoice_{invoiceDto.InvoiceNumber}.pdf", "application/pdf", base64);
        }
    }

    private string GetWashPackageName(string packageId)
    {
        return packageId switch
        {
            "wash_wax_dry" => "Wash, Wax & Dry",
            "wash_vacuum" => "Wash & Vacuum",
            "mini_valet" => "Mini Valet",
            "super_tango_valet" => "Super Tango Valet",
            "super_ceramic_valet" => "Super Ceramic Valet",
            "super_glaze_valet" => "Super Glaze Valet",
            "full_valet" => "Full Valet",
            "tango_full_valet" => "Tango Full Valet",
            "connoisseurs_wax" => "Connoisseurs Wax (Machine Polish)",
            _ => packageId
        };
    }

    private string GetAddOnName(string addonId)
    {
        return addonId switch
        {
            "tyre_shine" => "Tyre Shine",
            "tango_wax" => "Tango Wax (Spray)",
            "ceramic_spray" => "Ceramic (Spray)",
            "glaze_spray" => "Glaze (Spray)",
            "fallout_removal" => "Fall Out Removal (Metal Particles)",
            "windows" => "Windows",
            "dashboard" => "Dashboard (All Plastics)",
            "vacuum" => "Vacuum",
            "screen_wash_topup" => "Screen Wash Top Up",
            "screen_wash_5l" => "Screen Wash 5 Litre",
            _ => addonId
        };
    }

    private void UpdateInvoiceData()
    {
        decimal baseAmount = originalAmount > 0 ? originalAmount : carWashCharges;
        decimal finalAmount = carWashCharges; // This is the amount after any discounts
        
        // Clear existing service items
        invoiceDto.ServiceItems.Clear();
        
        // Add detailed service items if we have selected vehicle with services
        if (selectedVehicle != null && !string.IsNullOrEmpty(selectedVehicle.WashPackage))
        {
            // Add main wash package
            string washPackageName = GetWashPackageName(selectedVehicle.WashPackage);
            string vehicleDescription = !string.IsNullOrEmpty(selectedVehicle.VanSize) 
                ? $"{selectedVehicle.Title} ({selectedVehicle.VanSize}) - {washPackageName}"
                : $"{selectedVehicle.Title} - {washPackageName}";
            
            invoiceDto.ServiceItems.Add(new ServiceItem 
            { 
                Description = vehicleDescription, 
                Quantity = 1, 
                UnitPrice = baseAmount, 
                TotalPrice = baseAmount 
            });
            
            // Add add-ons if any
            if (selectedVehicle.AddOns?.Any() == true)
            {
                foreach (var addon in selectedVehicle.AddOns)
                {
                    invoiceDto.ServiceItems.Add(new ServiceItem
                    {
                        Description = GetAddOnName(addon),
                        Quantity = 1,
                        UnitPrice = 0m, // Add-on prices are already included in the total
                        TotalPrice = 0m
                    });
                }
            }
            
            // Add dirty car charge if applicable
            if (selectedVehicle.DirtyCharge > 0)
            {
                invoiceDto.ServiceItems.Add(new ServiceItem
                {
                    Description = "Dirty Car Charge",
                    Quantity = 1,
                    UnitPrice = 0m, // Dirty charge is already included in the total
                    TotalPrice = 0m
                });
            }
        }
        else
        {
            // Fallback for simple service
            string serviceDescription = selectedVehicle != null ? $"{selectedVehicle.Title} Wash Service" : "Car Wash Service";
            invoiceDto.ServiceItems.Add(new ServiceItem 
            { 
                Description = serviceDescription, 
                Quantity = 1, 
                UnitPrice = baseAmount, 
                TotalPrice = baseAmount 
            });
        }
        
        // Add loyalty discount line if applicable
        if (redemptionType != LoyaltyRedemptionType.None)
        {
            string discountDescription = redemptionType switch
            {
                LoyaltyRedemptionType.FreeWash => "Loyalty Discount (10 points)",
                LoyaltyRedemptionType.HalfPrice => "Loyalty Discount (5 points)",
                _ => ""
            };
            
            if (!string.IsNullOrEmpty(discountDescription))
            {
                decimal discountAmount = baseAmount - finalAmount;
                
                invoiceDto.ServiceItems.Add(new ServiceItem
                {
                    Description = discountDescription,
                    Quantity = 1,
                    UnitPrice = -discountAmount,
                    TotalPrice = -discountAmount
                });
            }
        }
        
        // Calculate totals correctly
        invoiceDto.Subtotal = finalAmount; // Subtotal is the amount after discounts
        invoiceDto.TaxAmount = finalAmount * 0.20m; // Tax on the final amount
        invoiceDto.TotalAmount = finalAmount * 1.20m; // Total including tax
        invoiceDto.PaymentMethod = selectedPaymentMethod.ToString();
        invoiceDto.InvoiceNumber = $"INV-{DateTime.Now:yyyy-MM-dd-HHmmss}";
        invoiceDto.InvoiceDate = DateTime.Now;
        
        // Update vehicle information in invoice
        if (selectedVehicle != null)
        {
            invoiceDto.VehicleType = selectedVehicle.Title;
            invoiceDto.CustomerName = $"Vehicle Owner ({selectedVehicle.Title})";
        }
        else if (selectedCar != null)
        {
            invoiceDto.LicensePlate = selectedCar.LicensePlate;
            invoiceDto.CustomerName = $"Vehicle Owner ({selectedCar.Name})";
        }
    }

    public enum LoyaltyRedemptionType
    {
        None,
        HalfPrice = 5, // 5 points for 50% off
        FreeWash = 10 // 10 points for free wash
    }

    private decimal CalculateFinalAmount()
    {
        // Use the current carWashCharges value for calculations
        decimal baseAmount = carWashCharges > 0 ? carWashCharges : originalAmount;
        
        switch (redemptionType)
        {
            case LoyaltyRedemptionType.None:
                return baseAmount; // Full price - earn points
            case LoyaltyRedemptionType.HalfPrice:
                return baseAmount / 2; // 50% discount
            case LoyaltyRedemptionType.FreeWash:
                return 0.00m; // Free wash
            default:
                return baseAmount;
        }
    }

    async void SelectLoyaltyRedemption(LoyaltyRedemptionType type)
    {
        redemptionType = type;
        
        // Special handling for free wash - direct redemption with confirmation
        if (type == LoyaltyRedemptionType.FreeWash)
        {
            if (selectedCar != null && selectedCar.LoyaltyPoints >= 10)
            {
                // Show confirmation dialog
                bool confirmed = await JS.InvokeAsync<bool>("confirm", 
                    $"Are you sure you want to redeem 10 loyalty points for a FREE car wash?\n\n" +
                    $"Original amount: ${carWashCharges:F2}\n" +
                    $"Points available: {selectedCar.LoyaltyPoints}\n" +
                    $"Points after redemption: {selectedCar.LoyaltyPoints - 10}\n\n" +
                    $"This action cannot be undone.");

                if (!confirmed)
                {
                    return; // User cancelled
                }

                // Deduct points immediately
                selectedCar.LoyaltyPoints -= 10;
                CarService.UpdateCar(selectedCar);
                
                // Update invoice data
                UpdateInvoiceData();
                
                // Generate PDF and show popup
                pdfBytes = await InvoiceService.GenerateInvoice(invoiceDto);
                showInvoicePopup = true;
                
                // Show success message
                ToastService.ShowSuccess($"FREE wash redeemed! Used 10 loyalty points. Remaining points: {selectedCar.LoyaltyPoints}");
                
                // Reset payment selection
                isPaymentSelected = false;
                StateHasChanged(); // Refresh UI to show popup
                
                // Add transaction record for free wash
                var dto = new TransactionDto
                {
                    Amount = 0.00m, // Free wash
                    Date = DateTime.UtcNow,
                    Description = $"FREE wash for {GetCarInfo()} (redeemed 10 loyalty points)",
                    PaymentMethod = PaymentMethod.Other
                };
                TransactionService.AddTransaction(dto);
                
                StateHasChanged();
                return;
            }
            else
            {
                ToastService.ShowError("Insufficient loyalty points for free wash!");
                return;
            }
        }
        
        // Calculate new amount based on loyalty redemption
        // For half price, calculate 50% of the current amount
        if (type == LoyaltyRedemptionType.HalfPrice)
        {
            carWashCharges = carWashCharges / 2;
        }
        else
        {
            decimal newAmount = CalculateFinalAmount();
            carWashCharges = newAmount;
        }
        
        StateHasChanged();
    }

    private async Task HandleLoyaltyPoints()
    {
        if (selectedCar == null) return;

        try
        {
            switch (redemptionType)
            {
                case LoyaltyRedemptionType.None:
                    // Earn 1 point for paying full price
                    selectedCar.LoyaltyPoints += 1;
                    CarService.UpdateCar(selectedCar);
                    ToastService.ShowInfo($"You earned 1 loyalty point! Total: {selectedCar.LoyaltyPoints} points");
                    break;
                    
                case LoyaltyRedemptionType.HalfPrice:
                    // Spend 5 points for 50% off
                    if (selectedCar.LoyaltyPoints >= 5)
                    {
                        selectedCar.LoyaltyPoints -= 5;
                        CarService.UpdateCar(selectedCar);
                        ToastService.ShowSuccess($"Used 5 loyalty points for 50% off! Remaining points: {selectedCar.LoyaltyPoints}");
                    }
                    break;
                    
                case LoyaltyRedemptionType.FreeWash:
                    // Spend 10 points for free wash
                    if (selectedCar.LoyaltyPoints >= 10)
                    {
                        selectedCar.LoyaltyPoints -= 10;
                        CarService.UpdateCar(selectedCar);
                        ToastService.ShowSuccess($"Used 10 loyalty points for free wash! Remaining points: {selectedCar.LoyaltyPoints}");
                    }
                    break;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error updating loyalty points: {ex.Message}");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
            var queryParams = QueryHelpers.ParseQuery(uri.Query);
            
            // Check for vehicle parameter from Services page
            if (queryParams.TryGetValue("vehicle", out var vehicleJson))
            {
                var vehicleData = Uri.UnescapeDataString(vehicleJson);
                selectedVehicle = System.Text.Json.JsonSerializer.Deserialize<VehicleType>(vehicleData);
                
                // Set the amount from the selected vehicle
                if (selectedVehicle != null)
                {
                    carWashCharges = selectedVehicle.Amount;
                    originalAmount = carWashCharges;
                }
            }
            // Check for car parameter in URL (existing functionality)
            else if (queryParams.TryGetValue("car", out var carJson))
            {
                var carData = Uri.UnescapeDataString(carJson);
                selectedCar = System.Text.Json.JsonSerializer.Deserialize<CarDto>(carData);
                
                // Set default wash price if car is selected and amount is 0
                if (selectedCar != null && carWashCharges == 0)
                {
                    carWashCharges = 25.00m; // Default wash price
                    originalAmount = carWashCharges;
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading data: {ex.Message}");
        }
    }

    public enum PaymentStatus
    {
        InProgress,
        Successful,
        Canceled,
        Stopped,
        Error
    }

    private string GetCarInfo()
    {
        if (selectedCar != null)
        {
            return $"{selectedCar.Name} ({selectedCar.LicensePlate}) - {selectedCar.Color}";
        }
        else if (selectedVehicle != null)
        {
            return $"{selectedVehicle.Title} Service";
        }
        else
        {
            return "Unknown Vehicle";
        }
    }

