@page "/payment"
@using Blazored.Toast.Configuration
@using Blazored.Toast.Services
@using CarWashApp.Models
@using CarWashApp.Models.DTOs
@using CarWashApp.Responses.Status
@using CarWashApp.Services
@using CarWashApp.Services.HttpClientServices
@using System.Text.Json
@using System.Text

<button class="btn btn-lg btn-primary" @onclick="@(() => NavigationManager.NavigateTo("/"))"> Home</button>

@if (isPaymentSelected)
{
    <div class="container d-flex justify-content-center align-items-center"
         style="overflow: hidden;">

        <div class="card shadow-lg p-5 text-center"
             style="max-width: 500px; border-radius: 20px;">

            <h2 class="mb-4" style="font-size: 2rem; font-weight: bold;">
                Charges for car wash: <span style="color: #007bff;">@carWashCharges €</span>
            </h2>

            <p class="mb-3" style="font-size: 1.5rem; font-weight: 500;">
                You have paid:
            </p>

            <input type="number"
                   class="form-control form-control-lg text-center"
                   placeholder="Enter amount"
                   style="font-size: 1.5rem; border-radius: 12px;" />

            <div class="mt-4 d-flex gap-2 justify-content-center flex-wrap">
                <button @onclick="ProcessPayment"
                        class="btn btn-success btn-lg"
                        disabled="@(isProcessingPayment || isCancellingPayment)">
                    @if (isProcessingPayment)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        @:Processing...
                    }
                    else
                    {
                        <i class="bi bi-credit-card me-2"></i>
                        @:Process Payment
                    }
                </button>

                <button @onclick="CancelPayment"
                        class="btn btn-warning btn-lg"
                        disabled="@(isCancellingPayment)">
                    @if (isCancellingPayment)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        @:Cancelling...
                    }
                    else
                    {
                        <i class="bi bi-x-circle me-2"></i>
                        @:Cancel Payment
                    }
                </button>

                @* <button @onclick="CloseSession" 
                        class="btn btn-secondary btn-lg" 
                        disabled="@(isProcessingPayment || isCancellingPayment || isClosingSession)">
                    @if (isClosingSession)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        @:Closing...
                    }
                    else
                    {
                        <i class="bi bi-door-closed me-2"></i>
                        @:Close Session
                    }
                </button> *@
            </div>
        </div>
    </div>


}
else
{
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-lg">
                    <div class="card-header bg-success text-white text-center">
                        <h3 class="mb-0"><i class="bi bi-credit-card-2-front-fill me-2"></i>Payment Options</h3>
                    </div>
                    <div class="card-body text-center">
                        <p class="lead mb-4">Select your preferred payment method:</p>
                        <div class="d-flex flex-column gap-4 align-items-center">
                            <button @onclick=@(() => PaymentMethodSelected(PaymentMethod.Cash))
                                    class="btn btn-primary btn-lg w-75" type="button">
                                <i class="bi bi-cash-coin me-2"></i>Cash
                            </button>
                            <button @onclick=@(() => PaymentMethodSelected(PaymentMethod.Card))
                                    class="btn btn-info btn-lg w-75 text-white" type="button">
                                <i class="bi bi-credit-card-2-front me-2"></i>Card
                            </button>
                            <button @onclick="DownloadPdf"
                                    class="btn btn-secondary btn-lg w-75 text-white" type="button">
                                <i class="bi bi-credit-card-2-front me-2"></i>Download PDF
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Inject] IToastService ToastService { get; set; }
    [Inject] CWPClient ApiClient { get; set; }
    [Inject] ITransactionService TransactionService { get; set; }
    [Inject] NavigationManager NavigationManager { get; set; }
    [Inject] InvoiceService InvoiceService { get; set; }
    [Inject] IJSRuntime JS { get; set; }

    bool isPaymentSelected = false;
    bool isProcessingPayment = false;
    bool isCancellingPayment = false;
    int carWashCharges = 8;
    byte[] pdfBytes;

    InvoiceDto invoiceDto = new()
    {
        Service = "Full Wash",
        CustomerName = "Test Customer",
        Amount = "8"
    };

    PaymentMethod selectedPaymentMethod;
    async Task PaymentMethodSelected(PaymentMethod method)
    {
        selectedPaymentMethod = method;
        isPaymentSelected = true;
    }


    async Task ProcessPayment()
    {
        isProcessingPayment = true;
        try
        {
            ToastService.ShowInfo("Starting payment...");

            // Use the new safe payment method
            var result = await ApiClient.StartPaymentSafely(carWashCharges);

            if (result.Success)
            {
                // Payment started successfully
                ToastService.ShowSuccess(result.Message);

                // Add transaction record
                var dto = new TransactionDto
                {
                    Amount = carWashCharges,
                    Date = DateTime.UtcNow,
                    Description = $"Paid {carWashCharges} using {selectedPaymentMethod.ToString()}",
                    PaymentMethod = selectedPaymentMethod
                };
                TransactionService.AddTransaction(dto);

                // Monitor payment status
                while (true)
                {
                    var status = await ApiClient.CheckPaymentStatus();
                    var latestEvent = status?.Events?.LastOrDefault();

                    if (latestEvent != null)
                    {
                        if (Enum.TryParse(latestEvent.EventType, out EventType latestEventType))
                        {
                            switch (latestEventType)
                            {
                                case EventType.Waiting:
                                    ToastService.ShowInfo("Payment session is active and waiting for cash.");
                                    break;
                                case EventType.PaymentComplete:
                                    ToastService.ShowSuccess("Payment completed successfully!");
                                    isPaymentSelected = false; // Reset payment selection
                                    pdfBytes = await InvoiceService.GenerateInvoice(invoiceDto);
                                    return;
                                case EventType.CancelComplete:
                                    ToastService.ShowWarning("Payment was canceled.");
                                    isPaymentSelected = false; // Reset payment selection 
                                    return;
                                case EventType.StoppingPayment:
                                    ToastService.ShowWarning("Payment is stopping...");
                                    break;
                                case EventType.Idle:
                                    isPaymentSelected = false; // Reset payment selection
                                    return;
                                default:
                                    ToastService.ShowInfo($"Payment in progress... Current status: {latestEventType}");
                                    break;
                            }
                        }
                    }

                    // Add a delay to prevent rapid, unnecessary polling
                    await Task.Delay(3000);
                }
            }
            else
            {
                // Payment failed
                ToastService.ShowError(result.Message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Payment error: {ex.Message}");
        }
        finally
        {
            isProcessingPayment = false;
        }
    }

    async Task CancelPayment()
    {
        isCancellingPayment = true;
        try
        {
            ToastService.ShowInfo("Cancelling payment...");

            // Use the new safe cancel method
            var result = await ApiClient.CancelPaymentSafely();

            if (result.Success)
            {
                ToastService.ShowSuccess(result.Message);
                // NavigationManager.NavigateTo("/");
            }
            else
            {
                ToastService.ShowWarning(result.Message);
            }

            // Reset payment selection regardless of success/failure
            isPaymentSelected = false;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Cancel payment error: {ex.Message}");
            // Still reset payment selection on error
            isPaymentSelected = false;
        }
        finally
        {
            isCancellingPayment = false;
        }
    }

    private async Task DownloadPdf()
    {
        var pdfBytes = await InvoiceService.GenerateInvoice(invoiceDto);

        if(pdfBytes is not null)
        {
            string base64 = Convert.ToBase64String(pdfBytes);

            await JS.InvokeVoidAsync("downloadHelper", "Invoice.pdf", "application/pdf", base64);
        }
    }

    public enum PaymentStatus
    {
        InProgress,
        Successful,
        Canceled,
        Stopped,
        Error
    }

}
