@page "/payment"
@using Blazored.Toast.Configuration
@using Blazored.Toast.Services
@using CarWashApp.Models
@using CarWashApp.Models.DTOs
@using CarWashApp.Responses.Status
@using CarWashApp.Services
@using CarWashApp.Services.HttpClientServices
@using System.Text.Json
@using System.Text
@using CarWashApp.Services.Scanner
@using Microsoft.AspNetCore.WebUtilities
@using CarWashApp.Components.Shared
@using CarWashApp.Services.Log
@using System.IO

<div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
    <button class="btn btn-primary btn-sm" @onclick="@(() => NavigationManager.NavigateTo("/"))"> Home</button>
    
    @if (isPaymentSelected && (selectedPaymentMethod == PaymentMethod.Card || selectedPaymentMethod == PaymentMethod.Split))
    {
        <button @onclick="OpenScanner"
                class="btn btn-success btn-sm"
                disabled="@(isOpeningScanner || scannerIsOpen)">
            @if (isOpeningScanner)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                @:Opening...
            }
            else if (scannerIsOpen)
            {
                <i class="bi bi-check-circle me-2"></i>
                @:Scanner Open
            }
            else
            {
                <i class="bi bi-power me-2"></i>
                @:Open Scanner
            }
        </button>
    }
    else
    {
        <div></div> @* Empty div to maintain flex layout *@
    }
</div>

<Popup IsOpen="@isPaymentSelected"
       IsOpenChanged="OnCheckoutPopupOpenChanged"
       Title="Checkout"
       CssClass="popup-checkout"
       BackdropCssClass="popup-backdrop-soft"
       CloseOnBackdropClick="true">
    <div class="checkout-popup-inner shadow-sm">
        <p class="text-muted small text-uppercase mb-1" style="letter-spacing: .04em;">Total to pay</p>
        <div class="mb-2">
            <InputNumber @bind-Value="CarWashCharges"
                         type="number"
                         step="0.01"
                         class="form-control form-control-lg text-center fw-bold py-2"
                         placeholder="0.00"
                         style="font-size: clamp(1.1rem, 3.5vw, 1.4rem); border-radius: 8px;" />
        </div>

        @if (selectedPaymentMethod == PaymentMethod.Split)
        {
            <hr class="my-2" />
            <p class="small fw-semibold text-start mb-2">Split: cash + card</p>

            <div class="text-start small">
                <label class="form-label mb-1 fw-bold d-flex align-items-center gap-1">
                    <i class="bi bi-cash-coin text-success fs-5" aria-hidden="true"></i>
                    <span>Cash</span>
                </label>
                <InputNumber @bind-Value="SplitCashAmountBinding"
                             type="number"
                             step="0.01"
                             class="form-control form-control-sm text-center mb-2"
                             placeholder="0.00" />
            </div>

            <div class="d-flex justify-content-between align-items-center small mb-1 px-1">
                <span class="fw-bold d-flex align-items-center gap-1 text-body">
                    <i class="bi bi-credit-card-2-front text-primary fs-5" aria-hidden="true"></i>
                    <span>Card</span>
                </span>
                <span class="fw-semibold">@GetSplitCardAmount().ToString("C")</span>
            </div>

            <div class="d-flex justify-content-between align-items-center small mb-2 px-1 border-top pt-2">
                <span class="text-muted">Cash + card</span>
                <span class="fw-bold @(SplitAmountsSumMatchesTotal ? "text-success" : "text-danger")">
                    @((splitCashAmount + GetSplitCardAmount()).ToString("C"))
                </span>
            </div>

            @if (!SplitAmountsSumMatchesTotal && carWashCharges > 0)
            {
                <div class="alert alert-warning py-1 px-2 mb-2 small text-start" role="alert">
                    Cash plus card must equal the total. Adjust amounts or the total above.
                </div>
            }
        }

        <div class="mt-2 d-grid gap-2">
            <button type="button"
                    @onclick="ProcessPayment"
                    class="btn btn-success"
                    disabled="@(isProcessingPayment || isCancellingPayment || !CanProceedToCheckout)">
                @if (isProcessingPayment)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    @:Processing...
                }
                else if (selectedPaymentMethod == PaymentMethod.Split)
                {
                    <i class="bi bi-wallet2 me-1"></i>
                    @:Pay
                }
                else if (selectedPaymentMethod == PaymentMethod.Cash)
                {
                    <i class="bi bi-cash-coin me-1"></i>
                    @:Pay with cash
                }
                else
                {
                    <i class="bi bi-credit-card me-1"></i>
                    @:Scan Image
                }
            </button>
        </div>
    </div>
</Popup>

@if (isPaymentSelected && !string.IsNullOrEmpty(ImageDataUri))
{
    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-lg">
                    <div class="card-header bg-info text-white text-center">
                        <h4 class="mb-0"><i class="bi bi-image me-2"></i>Captured Invoice Image</h4>
                    </div>
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <img src="@ImageDataUri"
                                 alt="Captured Invoice"
                                 class="img-fluid"
                                 style="max-width: 100%; max-height: 600px; height: auto; border: 2px solid #ddd; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);" />
                        </div>
                        <div class="d-flex justify-content-center">
                            <button class="btn btn-outline-danger btn-sm" @onclick="RetryCapture" title="Retry capture">
                                <i class="bi bi-arrow-clockwise me-1"></i>Retry
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(LastCapturedImage))
                        {
                            <div class="mt-2">
                                <small class="text-muted">
                                    <i class="bi bi-file-image me-1"></i>Filename: @LastCapturedImage
                                </small>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <!-- Vehicle Information Card -->
                @if (selectedCar != null)
                {
                    <div class="card mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="bi bi-car-front me-2"></i>Selected Vehicle</h5>
                        </div>
                        <div class="card-body">
                            <p class="mb-1"><strong>Car:</strong> @selectedCar.Name</p>
                            <p class="mb-1"><strong>License Plate:</strong> @selectedCar.LicensePlate</p>
                            <p class="mb-0"><strong>Available Points:</strong> <span class="badge bg-warning text-dark">@selectedCar.LoyaltyPoints points</span></p>
                        </div>
                    </div>
                }
                else if (selectedVehicle != null)
                {
                    <div class="card mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="bi bi-car-front me-2"></i>Selected Service</h5>
                        </div>
                        <div class="card-body">
                            <p class="mb-1"><strong>Vehicle:</strong> @selectedVehicle.Title</p>
                            @if (!string.IsNullOrEmpty(selectedVehicle.VanSize))
                            {
                                <p class="mb-1"><strong>Van Size:</strong> @selectedVehicle.VanSize</p>
                            }
                            @if (!string.IsNullOrEmpty(selectedVehicle.WashPackage))
                            {
                                <p class="mb-1"><strong>Wash Package:</strong> @GetWashPackageName(selectedVehicle.WashPackage)</p>
                            }
                            @if (selectedVehicle.AddOns?.Any() == true)
                            {
                                <p class="mb-1"><strong>Add-ons:</strong></p>
                                <ul class="mb-1">
                                    @foreach (var addon in selectedVehicle.AddOns)
                                    {
                                        <li>@GetAddOnName(addon)</li>
                                    }
                                </ul>
                            }
                            @if (selectedVehicle.DirtyCharge > 0)
                            {
                                <p class="mb-1"><strong>Dirty Car Charge:</strong> +£@selectedVehicle.DirtyCharge.ToString("F2")</p>
                            }
                            <p class="mb-0"><strong>Total Amount:</strong> <span class="badge bg-success text-white">£@selectedVehicle.Amount.ToString("F2")</span></p>
                        </div>
                    </div>
                }

                <!-- Amount Input Section -->
                @if (selectedCar != null || selectedVehicle != null)
                {
                    <div class="card mb-4">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0"><i class="bi bi-calculator me-2"></i>Enter Amount</h5>
                        </div>
                        <div class="card-body text-center">
                            <p class="mb-3">Enter the amount for your car wash service:</p>
                            <div class="mb-3">
                                <InputNumber @bind-Value="CarWashCharges"
                                           type="number"
                                           step="0.01"
                                           class="form-control form-control-lg text-center"
                                           placeholder="Enter amount"
                                           style="font-size: 1.2rem; border-radius: 8px;"
                                           />
                            </div>
                            <small class="text-muted">Minimum amount: $5.00</small>
                        </div>
                    </div>
                }

                <!-- Loyalty Points Redemption Options - Only show if car data is available -->
                @if (selectedCar != null)
                {
                    <div class="card mb-4">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0"><i class="bi bi-star-fill me-2"></i>Loyalty Points Redemption</h5>
                        </div>
                        <div class="card-body text-center">
                            <p class="mb-3">You have <strong>@selectedCar.LoyaltyPoints points</strong> available!</p>
                            <p class="mb-3 text-muted">Amount: <strong>$@carWashCharges.ToString("F2")</strong></p>
                                <div class="d-flex flex-column gap-3 align-items-center">
                                @if (selectedCar.LoyaltyPoints >= 5)
                                {
                                    var currentAmount = carWashCharges > 0 ? carWashCharges : (originalAmount > 0 ? originalAmount : 0);
                                    var discountAmount = currentAmount / 2;
                                    <button @onclick="@(() => SelectLoyaltyRedemption(LoyaltyRedemptionType.HalfPrice))"
                                            class="btn btn-warning btn-lg w-75 @(redemptionType == LoyaltyRedemptionType.HalfPrice ? "border-primary" : "")"
                                            style="border-width: 3px;" title="Use 5 points for 50% off">
                                        <i class="bi bi-star me-2"></i>
                                        5 Points = 50% OFF<br>
                                        <small>Pay $@discountAmount.ToString("F2") instead of $@currentAmount.ToString("F2")</small>
                                    </button>
                                }
                                
                                @if (selectedCar.LoyaltyPoints >= 10)
                                {
                                    <button @onclick="@(() => SelectLoyaltyRedemption(LoyaltyRedemptionType.FreeWash))"
                                            class="btn btn-success btn-lg w-75 @(redemptionType == LoyaltyRedemptionType.FreeWash ? "border-primary" : "")"
                                            style="border-width: 3px;" title="Use 10 points for free wash">
                                        <i class="bi bi-gift me-2"></i>
                                        10 Points = FREE WASH<br>
                                        <small>No payment required! (Was $@carWashCharges.ToString("F2"))</small>
                                    </button>
                                }
                                

                                @if (selectedCar.LoyaltyPoints < 5)
                                {
                                    <div class="alert alert-info mt-3">
                                        <i class="bi bi-info-circle me-2"></i>
                                        <strong>Need more points!</strong> Earn @(5 - selectedCar.LoyaltyPoints) more point(s) to unlock 50% off redemption.
                                        Pay full price today to earn 1 loyalty point!
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (selectedVehicle != null)
                {
                    <div class="card mb-4">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Loyalty Points Information</h5>
                        </div>
                        <div class="card-body text-center">
                            <p class="mb-3">To use loyalty points, please select a registered vehicle first.</p>
                            <p class="mb-3 text-muted">Amount: <strong>£@carWashCharges.ToString("F2")</strong></p>
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>
                                <strong>Want to earn loyalty points?</strong> Register your vehicle to start earning points with each wash!
                            </div>
                        </div>
                    </div>
                }

                <div class="card shadow-lg">
                    <div class="card-header bg-success text-white text-center">
                        <h3 class="mb-0"><i class="bi bi-credit-card-2-front-fill me-2"></i>Payment Options</h3>
                    </div>
                    <div class="card-body text-center">
                        <p class="lead mb-4">Select your preferred payment method:</p>
                        <div class="d-flex flex-column gap-4 align-items-center">
                            <button @onclick=@(() => PaymentMethodSelected(PaymentMethod.Cash))
                                    class="btn btn-primary btn-lg w-75" type="button">
                                <i class="bi bi-cash-coin me-2"></i>Cash
                            </button>
                            <button @onclick=@(() => PaymentMethodSelected(PaymentMethod.Card))
                                    class="btn btn-info btn-lg w-75 text-white" type="button">
                                <i class="bi bi-credit-card-2-front me-2"></i>Card
                            </button>
                            @if (carWashCharges > 0)
                            {
                                <button @onclick=@(() => PaymentMethodSelected(PaymentMethod.Split))
                                        class="btn btn-warning btn-lg w-75 text-dark" type="button">
                                    <i class="bi bi-cash-stack me-2"></i>Split (cash + card)
                                </button>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

<Popup IsOpen="@showInvoicePopup"
       IsOpenChanged="@((bool isOpen) => showInvoicePopup = isOpen)"
       Title="Invoice - Payment Complete"
       CloseOnBackdropClick="true">
    <div class="text-center">
        @if (pdfBytes != null)
        {
            <div class="mb-3">
                <p class="lead">Your payment has been processed successfully!</p>
                <p class="text-muted">Invoice #@invoiceDto.InvoiceNumber</p>
            </div>

            <div class="d-flex flex-column gap-3 align-items-center">
                <button @onclick="ViewPdfInBrowser"
                        class="btn btn-primary btn-lg w-75">
                    <i class="bi bi-eye me-2"></i>View Invoice
                </button>

                <button @onclick="PrintPdfFromPopup"
                        class="btn btn-warning btn-lg w-75">
                    <i class="bi bi-printer me-2"></i>Print Invoice
                </button>

                <button @onclick="DownloadPdfFromPopup"
                        class="btn btn-success btn-lg w-75">
                    <i class="bi bi-download me-2"></i>Download PDF
                </button>

                <button @onclick="CloseInvoicePopup"
                        class="btn btn-secondary w-75">
                    <i class="bi bi-x-circle me-2"></i>Close
                </button>
            </div>
        }
        else
        {
            <div class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Generating invoice...</span>
                </div>
                <p class="mt-2">Generating your invoice...</p>
            </div>
        }
    </div>
</Popup>

@code {
    [Inject] IToastService ToastService { get; set; }
    [Inject] CWPClient ApiClient { get; set; }
    [Inject] ITransactionService TransactionService { get; set; }
    [Inject] NavigationManager NavigationManager { get; set; }
    [Inject] InvoiceService InvoiceService { get; set; }
    [Inject] IJSRuntime JS { get; set; }
    [Inject] ICarService CarService { get; set; }

    public class VehicleType
    {
        public string Title { get; set; } = "";
        public string? Subtitle { get; set; }
        public string? Description { get; set; }
        public string? IconUrl { get; set; }
        public decimal Amount { get; set; }
        public string VanSize { get; set; } = "";
        public string WashPackage { get; set; } = "";
        public List<string> AddOns { get; set; } = new();
        public decimal DirtyCharge { get; set; } = 0m;
    }

    bool isPaymentSelected = false;
    bool isProcessingPayment = false;
    bool isCancellingPayment = false;
    bool showInvoicePopup = false;
    private decimal carWashCharges;
    private CarDto selectedCar;
    private VehicleType selectedVehicle;
    private bool useLoyaltyRedemption = false;
    private LoyaltyRedemptionType redemptionType = LoyaltyRedemptionType.None;
    private decimal originalAmount = 0m;
    
    // Scanner state tracking
    private bool scannerIsOpen = false;
    private bool isOpeningScanner = false;

    decimal CarWashCharges
    {
        get => carWashCharges;
        set
        {
            if (value < 0)
            {
                carWashCharges = 0;
            }
            else
            {
                value = Math.Truncate(value * 100) / 100;
                carWashCharges = value;

                if (selectedPaymentMethod == PaymentMethod.Split && carWashCharges > 0.02m &&
                    splitCashAmount > carWashCharges - 0.01m)
                {
                    splitCashAmount = Math.Truncate((carWashCharges - 0.01m) * 100) / 100;
                    splitCashAmount = Math.Max(0.01m, splitCashAmount);
                }

                // Store the user-entered amount as original amount if it's valid
                if (value >= 5)
                {
                    originalAmount = value;
                }

                // Force UI refresh to update loyalty calculations
                StateHasChanged();
            }
        }
    }

    byte[] pdfBytes;

    InvoiceDto invoiceDto = new()
    {
        CustomerName = "Test Customer",
        CustomerEmail = "customer@email.com",
        CustomerPhone = "+1234567890",
        VehicleType = "Car",
        LicensePlate = "ABC123",
        InvoiceNumber = $"INV-{DateTime.Now:yyyy-MM-dd-HHmmss}",
        InvoiceDate = DateTime.Now,
        ServiceItems = new List<ServiceItem>
        {
            new ServiceItem { Description = "Car Wash Service", Quantity = 1, UnitPrice = 0m, TotalPrice = 0m }
        },
        Subtotal = 0m,
        TaxRate = 0.20m,
        TaxAmount = 0m,
        TotalAmount = 0m,
        PaymentMethod = "Cash",
        Notes = "Car wash service completed successfully."
    };

    PaymentMethod selectedPaymentMethod;
    /// <summary>Cash portion when <see cref="PaymentMethod.Split"/> is selected.</summary>
    private decimal splitCashAmount;

    /// <summary>Input binding for split cash amount (2 decimal places).</summary>
    private decimal SplitCashAmountBinding
    {
        get => splitCashAmount;
        set
        {
            var v = Math.Truncate(Math.Max(0, value) * 100) / 100;
            if (carWashCharges > 0.01m && v > carWashCharges - 0.01m)
                v = Math.Truncate((carWashCharges - 0.01m) * 100) / 100;
            splitCashAmount = Math.Max(0, v);
            StateHasChanged();
        }
    }

    private decimal GetSplitCardAmount()
    {
        var card = carWashCharges - splitCashAmount;
        return Math.Truncate(Math.Max(0, card) * 100) / 100;
    }

    /// <summary>True when cash + card equals total (within 2p) and both parts are positive.</summary>
    private bool SplitAmountsSumMatchesTotal =>
        carWashCharges > 0 &&
        splitCashAmount >= 0.01m &&
        GetSplitCardAmount() >= 0.01m &&
        Math.Abs(splitCashAmount + GetSplitCardAmount() - carWashCharges) <= 0.02m;

    /// <summary>Checkout allowed: positive total; for split, amounts must match total.</summary>
    private bool CanProceedToCheckout =>
        carWashCharges > 0 &&
        (selectedPaymentMethod != PaymentMethod.Split || SplitAmountsSumMatchesTotal);

    Task PaymentMethodSelected(PaymentMethod method)
    {
        selectedPaymentMethod = method;

        LogScannerEvent($"Payment method selected: {selectedPaymentMethod}");

        // If switching away from card / split (scanner), reset scanner state
        if (method != PaymentMethod.Card && method != PaymentMethod.Split && scannerIsOpen)
        {
            LogScannerEvent("Payment method changed away from card/split. Resetting scanner state.");
            scannerIsOpen = false;
        }

        if (method == PaymentMethod.Split && carWashCharges > 0)
        {
            splitCashAmount = Math.Round(carWashCharges / 2, 2, MidpointRounding.AwayFromZero);
            var cardPart = GetSplitCardAmount();
            if (splitCashAmount < 0.01m || cardPart < 0.01m)
                splitCashAmount = Math.Round(carWashCharges * 0.5m, 2, MidpointRounding.AwayFromZero);
            if (splitCashAmount >= carWashCharges)
                splitCashAmount = Math.Truncate((carWashCharges - 0.01m) * 100) / 100;
            if (splitCashAmount < 0.01m)
                splitCashAmount = 0.01m;
        }

        // Store original amount when payment method is first selected
        if (originalAmount == 0)
        {
            originalAmount = carWashCharges;
        }

        isPaymentSelected = true;
        StateHasChanged(); // Trigger UI refresh to show loyalty options
        return Task.CompletedTask;
    }

    private Task OnCheckoutPopupOpenChanged(bool open)
    {
        isPaymentSelected = open;
        if (!open && scannerIsOpen)
            scannerIsOpen = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    async Task ProcessPayment()
    {
        LogScannerEvent("ProcessPayment started.");
        if (!CanProceedToCheckout)
        {
            ToastService.ShowWarning("Total must be greater than zero. For split pay, cash + card must equal the total.");
            return;
        }

        isProcessingPayment = true;
        try
        {
            // Always close any active session before starting a new payment.
            await EnsureNoActiveSessionForNewPayment();

            // Handle card payments differently from cash payments
            if (selectedPaymentMethod == PaymentMethod.Card)
            {
                LogScannerEvent("Card payment detected. Initiating capture workflow.");
                // await ProcessCardPayment();
                await TestCapture();
                return;
            }

            // Split: cash device first for cash portion, then card (scanner) for remainder — one transaction
            if (selectedPaymentMethod == PaymentMethod.Split)
            {
                if (!ValidateSplitAmounts())
                    return;

                var cashPart = splitCashAmount;
                var cardPart = GetSplitCardAmount();
                LogScannerEvent($"Split payment: cash={cashPart}, card={cardPart}, total={carWashCharges}");

                ToastService.ShowInfo($"Step 1/2: Take {cashPart:C} in cash on the device…");
                var cashOk = await StartCashSessionAndPollUntilCompleteAsync(cashPart);
                if (!cashOk)
                    return;

                ToastService.ShowInfo($"Cash received. Step 2/2: Take {cardPart:C} on card, then capture (Scan).");
                await TestCapture();

                var splitDescription = redemptionType switch
                {
                    LoyaltyRedemptionType.FreeWash => $"FREE wash for {GetCarInfo()} (redeemed 10 loyalty points)",
                    LoyaltyRedemptionType.HalfPrice => $"Paid {carWashCharges:C} split ({cashPart:C} cash + {cardPart:C} card) for {GetCarInfo()} (redeemed 5 loyalty points - was {originalAmount:C})",
                    _ => $"Paid {carWashCharges:C} split ({cashPart:C} cash + {cardPart:C} card) for {GetCarInfo()} (earned 1 loyalty point)"
                };

                TransactionService.AddTransaction(new TransactionDto
                {
                    Amount = carWashCharges,
                    Date = DateTime.UtcNow,
                    Description = splitDescription,
                    PaymentMethod = PaymentMethod.Split
                });

                await HandleLoyaltyPoints();
                UpdateInvoiceData();
                pdfBytes = await InvoiceService.GenerateInvoice(invoiceDto);
                showInvoicePopup = true;
                isPaymentSelected = false;
                StateHasChanged();
                ToastService.ShowSuccess("Split payment completed.");
                return;
            }

            // Handle cash payments (existing logic)
            ToastService.ShowInfo("Starting payment...");
            LogScannerEvent("Cash payment flow initiated.");

            // Use the new safe payment method
            var result = await ApiClient.StartPaymentSafely(carWashCharges * 100);

            if (result.Success)
            {
                // Payment started successfully
                ToastService.ShowSuccess(result.Message);

                // Add transaction record
                var description = redemptionType switch
                {
                    LoyaltyRedemptionType.FreeWash => $"FREE wash for {GetCarInfo()} (redeemed 10 loyalty points)",
                    LoyaltyRedemptionType.HalfPrice => $"Paid {carWashCharges:C} using {selectedPaymentMethod.ToString()} for {GetCarInfo()} (redeemed 5 loyalty points - was {originalAmount:C})",
                    _ => $"Paid {carWashCharges:C} using {selectedPaymentMethod.ToString()} for {GetCarInfo()} (earned 1 loyalty point)"
                };

                var dto = new TransactionDto
                {
                    Amount = carWashCharges,
                    Date = DateTime.UtcNow,
                    Description = description,
                    PaymentMethod = selectedPaymentMethod
                };
                TransactionService.AddTransaction(dto);

                var completed = await PollCashPaymentUntilTerminalAsync();
                if (completed)
                {
                    ToastService.ShowSuccess("Payment completed successfully!");
                    await HandleLoyaltyPoints();
                    UpdateInvoiceData();
                    pdfBytes = await InvoiceService.GenerateInvoice(invoiceDto);
                    showInvoicePopup = true;
                    isPaymentSelected = false;
                    StateHasChanged();
                }
            }
            else
            {
                // Payment failed
                ToastService.ShowError(result.Message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Payment error: {ex.Message}");
            LogScannerEvent("ProcessPayment threw an exception.", ex);
        }
        finally
        {
            isProcessingPayment = false;
            LogScannerEvent("ProcessPayment finished.");
        }
    }

    private bool ValidateSplitAmounts()
    {
        var cardPart = GetSplitCardAmount();
        if (carWashCharges <= 0)
        {
            ToastService.ShowError("No amount to split.");
            return false;
        }

        if (splitCashAmount < 0.01m || cardPart < 0.01m)
        {
            ToastService.ShowError("Enter a cash amount so both cash and card parts are at least £0.01.");
            return false;
        }

        if (Math.Abs(splitCashAmount + cardPart - carWashCharges) > 0.02m)
        {
            ToastService.ShowError($"Cash ({splitCashAmount:C}) + card ({cardPart:C}) must equal total ({carWashCharges:C}).");
            return false;
        }

        return true;
    }

    /// <summary>Start a cash session for <paramref name="amount"/> and poll until paid, cancelled, or idle.</summary>
    private async Task<bool> StartCashSessionAndPollUntilCompleteAsync(decimal amount)
    {
        var result = await ApiClient.StartPaymentSafely(amount * 100);
        if (!result.Success)
        {
            ToastService.ShowError(result.Message);
            return false;
        }

        ToastService.ShowSuccess(result.Message);
        return await PollCashPaymentUntilTerminalAsync();
    }

    /// <summary>Poll payment device after a cash session has already been started.</summary>
    private async Task<bool> PollCashPaymentUntilTerminalAsync()
    {
        while (true)
        {
            var status = await ApiClient.CheckPaymentStatus();
            var latestEvent = status?.Events?.LastOrDefault();

            if (latestEvent != null)
            {
                if (Enum.TryParse(latestEvent.EventType, out EventType latestEventType))
                {
                    switch (latestEventType)
                    {
                        case EventType.Waiting:
                            ToastService.ShowInfo("Payment session is active and waiting for cash.");
                            break;
                        case EventType.PaymentComplete:
                            return true;
                        case EventType.CancelComplete:
                            ToastService.ShowWarning("Payment was canceled.");
                            isPaymentSelected = false;
                            return false;
                        case EventType.StoppingPayment:
                            ToastService.ShowWarning("Payment is stopping...");
                            break;
                        case EventType.Idle:
                            isPaymentSelected = false;
                            return false;
                        default:
                            ToastService.ShowInfo($"Payment in progress... Current status: {latestEventType}");
                            break;
                    }
                }
            }

            await Task.Delay(3000);
        }
    }

    private async Task EnsureNoActiveSessionForNewPayment()
    {
        try
        {
            // If a payment session is already active, close it before starting a new one.
            var closeResponse = await ApiClient.CloseSession();
            if (closeResponse.IsSuccessStatusCode)
            {
                LogScannerEvent("Pre-payment CloseSession succeeded.");
            }
            else
            {
                LogScannerEvent($"Pre-payment CloseSession returned status {closeResponse.StatusCode}.");
            }
        }
        catch (Exception ex)
        {
            // Do not block the user if closing a stale session fails.
            LogScannerEvent("Pre-payment CloseSession failed; continuing anyway.", ex);
        }

        // Poll the payment status briefly to ensure the backend/device actually left the active session.
        try
        {
            // Active states we want to wait out:
            // - NewPayment / Waiting / PayInStarted / Payment / PayInComplete
            for (var attempt = 1; attempt <= 12; attempt++)
            {
                await Task.Delay(250);

                var status = await ApiClient.CheckPaymentStatus();
                var latestEvent = status?.Events?.LastOrDefault();
                if (latestEvent == null) return;

                if (!Enum.TryParse(latestEvent.EventType, out EventType latestEventType)) return;

                var active =
                    latestEventType == EventType.NewPayment ||
                    latestEventType == EventType.Waiting ||
                    latestEventType == EventType.PayInStarted ||
                    latestEventType == EventType.Payment ||
                    latestEventType == EventType.PayInComplete;

                LogScannerEvent($"Pre-payment session poll attempt {attempt}: {latestEventType} (active={active})");

                if (!active)
                    return;
            }
        }
        catch (Exception ex)
        {
            // If polling fails, we don't block the user; we'll still attempt the payment flow.
            LogScannerEvent("Pre-payment status polling failed; continuing anyway.", ex);
        }
    }
