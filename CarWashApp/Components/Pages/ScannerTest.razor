@page "/scanner-test"
@using CarWashApp.Services.Scanner
@using CarWashApp.Services.Log
@inject ScannerService ScannerService

<h3>Scanner Connectivity & API Test Panel</h3>

<div class="mt-3">
    <button class="btn btn-primary me-2" @onclick="TestScannerConnected">Check Scanner Count</button>
    <button class="btn btn-info me-2" @onclick="TestScannerName">Get Scanner Name</button>
    <button class="btn btn-success me-2" @onclick="TestOpenScanner">Open Scanner</button>
    <button class="btn btn-warning me-2" @onclick="TestCloseScanner">Close Scanner</button>
    <button class="btn btn-dark me-2" @onclick="TestCapture">Capture Test</button>
</div>

@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert @(IsSuccess ? "alert-success" : "alert-danger") mt-3">
        @Message
    </div>
}

@if (!string.IsNullOrEmpty(ImageDataUri))
{
    <div class="mt-4">
        <h4>Last Captured Image</h4>
        <div class="card">
            <div class="card-body">
                <img src="@ImageDataUri"
                     alt="Captured Invoice"
                     class="img-fluid"
                     style="max-width: 100%; height: auto; border: 1px solid #ddd; border-radius: 4px;" />
                @if (!string.IsNullOrEmpty(LastCapturedImage))
                {
                    <div class="mt-2">
                        <small class="text-muted">Filename: @LastCapturedImage</small>
                    </div>
                }
            </div>
        </div>
    </div>
}
@code {
    private string? Message;
    private bool IsSuccess;

    private void SetResult(bool success, string message)
    {
        IsSuccess = success;
        Message = message;
        LogService.Log(Message);
    }

    private async Task TestScannerConnected()
    {
        try
        {
            var count = ScannerService.IsScannerConnected();
            SetResult(count , $"Scanner Connected = {count}");
        }
        catch (Exception ex)
        {
            SetResult(false, "Error: " + ex.Message);
        }
    }

    private async Task TestScannerName()
    {
        try
        {
            string? name = ScannerService.GetScannerName();
            SetResult(name != null, name ?? "Name not found");
        }
        catch (Exception ex)
        {
            SetResult(false, "Error: " + ex.Message);
        }
    }

    private async Task TestOpenScanner()
    {
        try
        {
            bool result = ScannerService.OpenScanner();
            SetResult(result, result ? "Device Opened ✅" : "Failed to Open ❌");
        }
        catch (Exception ex)
        {
            SetResult(false, "Error: " + ex.Message);
        }
    }

    private async Task TestCloseScanner()
    {
        try
        {
            bool result = ScannerService.CloseScanner();
            SetResult(result, result ? "Device Closed ✅" : "Failed to Close ❌");
        }
        catch (Exception ex)
        {
            SetResult(false, "Error: " + ex.Message);
        }
    }
    [Inject] IConfiguration Configuration { get; set; }
    private async Task TestCapture()
    {
        try
        {
            var invoiceFolderPath = Configuration["InvoicePath"];

            if (string.IsNullOrWhiteSpace(invoiceFolderPath))
                throw new Exception("Invoice folder path is not configured.");

            // Ensure folder exists
            if (!Directory.Exists(invoiceFolderPath))
                Directory.CreateDirectory(invoiceFolderPath);

            // Create invoice file name
            string invoiceFileName = $"INV-{DateTime.Now:yyyyMMddHHmmss}.png";

            // Full save path
            string invoicePath = Path.Combine(invoiceFolderPath, invoiceFileName);

            string? output = ScannerService.ScanInvoice(invoicePath);

            if (output != null)
            {
                // Store the filename
                LastCapturedImage = invoiceFileName;

                // Load and display the image directly
                LoadImageFromPath(invoicePath);

                SetResult(true, $"Captured ✅ => {output}");
            }
            else
            {
                SetResult(false, "Capture Failed ❌");
            }

            SetResult(output != null,
                output != null ? $"Captured ✅ => {output}" : "Capture Failed ❌");
        }
        catch (Exception ex)
        {
            SetResult(false, "Error: " + ex);
        }
    }
    private string? ImageDataUri;
    private string? LastCapturedImage;

    private void LoadImageFromPath(string filePath)
    {
        try
        {
            if (File.Exists(filePath))
            {
                byte[] imageBytes = File.ReadAllBytes(filePath);
                string base64String = Convert.ToBase64String(imageBytes);
                ImageDataUri = $"data:image/png;base64,{base64String}";
                StateHasChanged();
            }
            else
            {
                ImageDataUri = null;
            }
        }
        catch (Exception ex)
        {
            ImageDataUri = null;
            SetResult(false, $"Error loading image: {ex.Message}");
        }
    }

}
