@page "/services"
@using System.Diagnostics.CodeAnalysis

<h3>Services</h3>

<div class="menu-grid" role="list">
    @if (Items is not null)
    {
        @foreach (var item in Items)
        {
            <button class="tile"
                    role="listitem"
                    type="button"
                    @onclick="() => SelectVehicle(item)"
                    aria-label="@item.Title">
                <div class="icon-wrap">
                    @if (!string.IsNullOrWhiteSpace(item.IconUrl))
                    {
                        <img src="@item.IconUrl" alt="" class="icon" />
                    }
                </div>

                <div class="title">@item.Title</div>
                @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                {
                    <div class="subtitle">@item.Subtitle</div>
                }
            </button>
        }
    }
    else
    {
        @* Skeleton placeholders *@
        @for (var i = 0; i < 8; i++)
        {
            <div class="tile skeleton">
                <div class="icon-wrap"></div>
                <div class="title skeleton-bar"></div>
            </div>
        }
    }
</div>


<Popup IsOpen="showPopup"
       IsOpenChanged="val => showPopup = val"
       Title="@selectedVehicle.Title">

    <ChildContent>
        <pre class="desc-text">@selectedVehicle.Description</pre>
    </ChildContent>

    <FooterContent>
        <button class="btn" @onclick="() => showPopup = false">Cancel</button>
        <button class="btn primary" @onclick="Confirm">Confirm</button>
    </FooterContent>
</Popup>

