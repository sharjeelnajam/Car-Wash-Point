<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Car Wash Point</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center" href="/" Match="NavLinkMatch.All">
                <i class="bi bi-house-door me-2" aria-hidden="true"></i>
                <span>Home</span>
            </NavLink>
        </div>

        @* Admin-only navigation items *@
        @if (isAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center" href="services" Match="NavLinkMatch.All">
                    <i class="bi bi-briefcase me-2" aria-hidden="true"></i>
                    <span>Services</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center" href="loyalty-system">
                    <i class="bi bi-gift me-2" aria-hidden="true"></i>
                    <span>Loyalty System</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center" href="admin-panel">
                    <i class="bi bi-gear me-2" aria-hidden="true"></i>
                    <span>Admin Panel</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center" href="transaction-count">
                    <i class="bi bi-list-ol me-2" aria-hidden="true"></i>
                    <span>Transaction Count</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center" href="transaction-list">
                    <i class="bi bi-list-check me-2" aria-hidden="true"></i>
                    <span>Transaction List</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center" href="transaction-list-datetime">
                    <i class="bi bi-clock-history me-2" aria-hidden="true"></i>
                    <span>DateTime</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center" href="transaction-log">
                    <i class="bi bi-journal-text me-2" aria-hidden="true"></i>
                    <span>Transaction Log</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <button class="nav-link d-flex align-items-center btn btn-link text-start w-100 border-0 p-0" @onclick="Logout">
                    <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>
                    <span>Logout (@AuthService.Username)</span>
                </button>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center" href="admin-login">
                    <i class="bi bi-shield-lock me-2" aria-hidden="true"></i>
                    <span>Admin Login</span>
                </NavLink>
            </div>
        }
    </nav>

</div>

@using CarWashApp.Services
@inject IAuthenticationService AuthService

@code {
    private bool collapseNavMenu = true;
    private bool isAuthenticated = false;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    protected override void OnInitialized()
    {
        AuthService.AuthenticationStateChanged += OnAuthenticationStateChanged;
        isAuthenticated = AuthService.IsAuthenticated;
    }

    private void OnAuthenticationStateChanged()
    {
        isAuthenticated = AuthService.IsAuthenticated;
        // InvokeAsync(StateHasChanged);
        StateHasChanged();
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        collapseNavMenu = true; // Close the nav menu after logout
    }

    public void Dispose()
    {
        AuthService.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
