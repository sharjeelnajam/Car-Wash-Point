<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Car Wash Point</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="cash-acceptance" Match="NavLinkMatch.All">
                <i class="bi bi-cash-coin me-2" aria-hidden="true"></i>
                <span>Cash Acceptance</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="change-dispensing">
                <i class="bi bi-coin me-2" aria-hidden="true"></i>
                <span>Change Dispensing</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="loyalty-system">
                <i class="bi bi-gift me-2" aria-hidden="true"></i>
                <span>Loyalty System</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin-panel">
                <i class="bi bi-gear me-2" aria-hidden="true"></i>
                <span>Admin Panel</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="remote-payout">
                <i class="bi bi-arrow-bar-up me-2" aria-hidden="true"></i>
                <span>Remote Payout</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="transaction-count">
                <i class="bi bi-list-ol me-2" aria-hidden="true"></i>
                <span>Transaction Count</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="transaction-list">
                <i class="bi bi-list-check me-2" aria-hidden="true"></i>
                <span>Transaction List</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="transaction-list-datetime">
                <i class="bi bi-clock-history me-2" aria-hidden="true"></i>
                <span>DateTime</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="transaction-log">
                <i class="bi bi-journal-text me-2" aria-hidden="true"></i>
                <span>Transaction Log</span>
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
