<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Runs on the shop PC next to the scanner. The scanner DLLs are 32-bit, so this is an x86 program. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>DrWashScannerHelper</AssemblyName>
    <RootNamespace>ScannerHelper</RootNamespace>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same native scanner wrapper the web app has -->
    <Compile Include="..\CarWashApp\Services\Scanner\ScannerInterop.cs" Link="Scanner\ScannerInterop.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native scanner libraries, copied next to the helper -->
    <None Include="..\CarWashApp\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\CarWashApp\*.ax" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Install-ScannerHelper.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Uninstall-ScannerHelper.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Verify-ShopPC.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
